# Copy to `.env` and fill in. Vars prefixed PUBLIC_ are exposed to the browser
# (inlined at build time — never put secrets here).

# --- Analytics ---------------------------------------------------------------
# Matomo is loaded via the Tag Manager container in BaseLayout (container
# YLdIYnl6 @ analytics.gavinrozzi.com, idSite 27) — no env var needed. It boots
# in cookieless mode (`requireCookieConsent`) and only sets a visitor cookie once
# the visitor accepts via the consent banner.

# Optional GA4 Measurement ID. When set, GA4 is injected on demand by
# src/utils/consent.ts AFTER the visitor accepts cookies — never before. The
# analytics helper then dual-dispatches events to Matomo and GA4.
PUBLIC_GA4_ID=

# Set to "true" locally to enable analytics in `npm run dev`: logs every event
# to the console AND dispatches to the trackers (otherwise tracking is
# production-only). Leave unset/blank in normal development.
PUBLIC_ANALYTICS_DEBUG=

# --- Lead pipeline (Netlify + Supabase) ---------------------------------------
# Supabase project the lead/email pipeline writes to. Without these,
# handle-market-report falls back to the legacy trigger-email-sequence path.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# HMAC secret for signed lead tokens: unsubscribe links and the first-party
# visitor token used for behaviour tracking. Must be IDENTICAL in the Netlify
# environment and the Supabase edge-function environment or tokens minted by one
# will not verify in the other. Generate with: openssl rand -base64 48
LEAD_TOKEN_SECRET=

# Shared secret required by the sync-zipcode-data function
# (sent as the X-Sync-Secret header). Run that sync after every `npm run data:all`.
SYNC_SECRET=

# --- Email delivery (Amazon SES) ----------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Must be a verified sender in the SES console before any mail will send.
SES_SENDER_EMAIL=
# SES_CONFIGURATION_SET=steven-frato-emails
# SITE_URL=https://stevenfrato.com

# --- Data pipeline ------------------------------------------------------------
# ANTHROPIC_API_KEY=
# NETLIFY_BUILD_HOOK=

# --- /admin SPW builder ---------------------------------------------------
# Required by src/lib/supabase/server.ts. The admin console signs in with the
# ANON key and relies on RLS + admin_users; it never uses the service key in a
# browser-reachable path.
SUPABASE_ANON_KEY=

# Fired by the builder's "Generate SPW" / "Publish changes" buttons. The site is
# statically built, so a new listing is not a live page until Netlify rebuilds.
NETLIFY_BUILD_HOOK=

# MLS screenshot extraction in /admin/spw-builder. OPTIONAL — without it the
# builder still works and the MLS fields are entered by hand; only the
# screenshot-reading step is disabled.
ANTHROPIC_API_KEY=
