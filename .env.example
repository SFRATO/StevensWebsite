# Copy to `.env` and fill in. Vars prefixed PUBLIC_ are exposed to the browser
# (inlined at build time — never put secrets here).

# --- Analytics ---------------------------------------------------------------
# Matomo is loaded unconditionally via the Tag Manager container in BaseLayout
# (container YLdIYnl6 @ analytics.gavinrozzi.com, idSite 27) — no env var needed.

# Optional GA4 Measurement ID. When set, GA4 loads alongside Matomo and the
# analytics helper dual-dispatches events to both. Leave blank to run Matomo only.
PUBLIC_GA4_ID=

# Set to "true" locally to enable analytics in `npm run dev`: logs every event
# to the console AND dispatches to the trackers (otherwise tracking is
# production-only). Leave unset/blank in normal development.
PUBLIC_ANALYTICS_DEBUG=

# --- Data pipeline / email (see CLAUDE.md for the full list) ------------------
# ANTHROPIC_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# SES_SENDER_EMAIL=
# NETLIFY_BUILD_HOOK=
