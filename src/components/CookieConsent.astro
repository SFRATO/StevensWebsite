---
/**
 * CookieConsent Component
 *
 * Opt-in cookie gate, mounted once in BaseLayout. Until the visitor accepts,
 * Matomo runs cookieless (`requireCookieConsent`, pushed in BaseLayout before
 * the container loads) and GA4 is not loaded at all.
 *
 * Rendered hidden on every page; shown only when no decision is on record.
 * See src/utils/consent.ts for the storage + tracker-application logic.
 */
---

<!--
  role="region" rather than "dialog": this banner is non-modal and does not trap
  focus, so announcing it as a dialog would misdescribe it. A labelled region
  puts it in the landmarks list where a screen-reader user can reach it. The
  `hidden` attribute alone removes it from the a11y tree — no aria-hidden needed.
-->
<div
  class="consent-banner"
  id="cookie-consent"
  role="region"
  aria-label="Cookie consent"
  hidden
>
  <div class="consent-inner">
    <div class="consent-copy">
      <p class="consent-title">We use cookies</p>
      <p class="consent-text">
        We use cookies to remember your area and show you market data that's
        actually relevant. Decline and the site still works — we just won't
        remember you between visits.
        <a href="/privacy/">Privacy policy</a>
      </p>
    </div>

    <div class="consent-actions">
      <button type="button" class="consent-btn consent-decline" id="consent-decline">
        Decline
      </button>
      <button type="button" class="consent-btn consent-accept" id="consent-accept">
        Accept
      </button>
    </div>
  </div>
</div>

<script>
  import { getConsent, setConsent, applyConsent } from '@utils/consent';
  import { trackEvent } from '@utils/analytics';

  const BANNER_ID = 'cookie-consent';
  const OPEN_CLASS = 'consent-open';

  const getBanner = () => document.getElementById(BANNER_ID);

  const openBanner = () => {
    const banner = getBanner();
    if (!banner) return;
    banner.hidden = false;
    // Two frames: one for the browser to lay the element out after `hidden` is
    // removed, one for the class change to register as a transition rather than
    // an initial style. A single rAF races the style recalc in some browsers.
    requestAnimationFrame(() =>
      requestAnimationFrame(() => banner.classList.add('visible'))
    );
    document.documentElement.classList.add(OPEN_CLASS);
  };

  const closeBanner = () => {
    const banner = getBanner();
    document.documentElement.classList.remove(OPEN_CLASS);
    if (!banner) return;
    banner.classList.remove('visible');
    // Match the CSS transition duration before removing from the a11y tree.
    setTimeout(() => {
      if (!banner.classList.contains('visible')) banner.hidden = true;
    }, 300);
  };

  const decide = (status: 'granted' | 'denied') => {
    setConsent(status);
    closeBanner();
    trackEvent('Engagement', 'Cookie Consent', status === 'granted' ? 'Accepted' : 'Declined');
  };

  let globalsBound = false;
  const bindGlobalsOnce = () => {
    if (globalsBound) return;
    globalsBound = true;

    // Re-opened from the "Cookie preferences" control on /privacy/.
    window.addEventListener('sf:consent-reset', openBanner);

    // A decision made in another tab should dismiss this one.
    window.addEventListener('storage', (e) => {
      if (e.key === 'sf_consent_v1' && e.newValue) {
        applyConsent(getConsent());
        closeBanner();
      }
    });
  };

  const initConsent = () => {
    const banner = getBanner();
    if (!banner) return;

    bindGlobalsOnce();

    // Re-apply on every navigation so trackers that (re)attach after a view
    // transition inherit the existing decision.
    const decision = getConsent();
    applyConsent(decision);

    const acceptBtn = document.getElementById('consent-accept');
    const declineBtn = document.getElementById('consent-decline');

    if (acceptBtn && !acceptBtn.dataset.bound) {
      acceptBtn.dataset.bound = '1';
      acceptBtn.addEventListener('click', () => decide('granted'));
    }
    if (declineBtn && !declineBtn.dataset.bound) {
      declineBtn.dataset.bound = '1';
      declineBtn.addEventListener('click', () => decide('denied'));
    }

    if (decision === null) {
      openBanner();
    } else {
      closeBanner();
    }
  };

  document.addEventListener('astro:page-load', initConsent);
</script>

<style>
  .consent-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    /* Above the sticky CTA and the exit popup — the cookie decision comes first. */
    z-index: var(--z-popover);
    background: rgba(12, 14, 17, 0.97);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-top: 1px solid var(--accent-line);
    box-shadow: 0 -12px 40px rgba(0, 0, 0, 0.7);
    padding: var(--space-4);
    padding-bottom: max(var(--space-4), env(safe-area-inset-bottom));
    transform: translateY(100%);
    transition: transform 0.3s ease-out;
  }

  .consent-banner.visible {
    transform: translateY(0);
  }

  .consent-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .consent-title {
    font-weight: var(--font-semibold);
    color: var(--text-primary);
    font-size: var(--text-base);
    margin: 0 0 var(--space-1);
  }

  .consent-text {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .consent-text a {
    color: var(--accent-bright);
    text-decoration: underline;
    white-space: nowrap;
  }

  .consent-actions {
    display: flex;
    gap: var(--space-3);
  }

  .consent-btn {
    flex: 1;
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    cursor: pointer;
    /* 44px minimum touch target */
    min-height: 44px;
    transition: all var(--transition-base);
  }

  .consent-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .consent-accept {
    background: var(--accent);
    color: var(--accent-ink);
    border: 1px solid var(--accent);
  }

  .consent-accept:hover {
    background: var(--accent-bright);
    border-color: var(--accent-bright);
    box-shadow: var(--glow-soft);
  }

  .consent-decline {
    background: transparent;
    color: var(--text-primary);
    border: 1px solid var(--rule-strong);
  }

  .consent-decline:hover {
    background: var(--accent-wash);
    border-color: var(--accent);
    color: var(--accent-bright);
  }

  /* Mobile: the sticky CTA also docks to the bottom — one bar at a time. */
  @media (max-width: 767px) {
    :global(html.consent-open .sticky-cta) {
      display: none;
    }
  }

  @media (min-width: 768px) {
    .consent-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-6);
    }

    .consent-actions {
      flex: 0 0 auto;
    }

    .consent-btn {
      flex: 0 0 auto;
      min-width: 120px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .consent-banner {
      transition: none;
    }
  }
</style>
