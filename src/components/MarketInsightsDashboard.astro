---
/**
 * MarketInsightsDashboard Component
 * Live market data cards pulled from counties.json and zipcodes.json at build time.
 * Replaces the old hardcoded static figures.
 */
import { computeMoversAndShakers, formatCurrency } from '@utils/market-analysis';
import countiesData from '../../data/processed/counties.json';
import zipcodesData from '../../data/processed/zipcodes.json';
import { getTownSlug, getTownNameByZipcode } from '../data/town-mappings';

interface CountyData {
  region: string;
  slug: string;
  period_end: string;
  median_sale_price: number | null;
  median_sale_price_yoy: number | null;
  median_dom: number | null;
  inventory: number | null;
  market_type: 'seller' | 'buyer' | 'balanced';
}

const counties = countiesData as CountyData[];

// Compute live movers for "most active communities" card
const movers = computeMoversAndShakers(5);
const hotTowns = movers.hotMarkets.length > 0
  ? movers.hotMarkets
  : movers.fastMarkets;

// Aggregate market health across all zipcodes
const allZipcodes = zipcodesData as Array<{ market_type: string }>;
const sellerCount = allZipcodes.filter((z) => z.market_type === 'seller').length;
const buyerCount = allZipcodes.filter((z) => z.market_type === 'buyer').length;
const balancedCount = allZipcodes.filter((z) => z.market_type === 'balanced').length;

// Format YoY
const fmtYoY = (v: number | null) => {
  if (v === null) return 'N/A';
  const sign = v > 0 ? '+' : '';
  return `${sign}${v.toFixed(1)}%`;
};

// Data freshness
const lastUpdated = counties[0]?.period_end
  ? new Date(counties[0].period_end).toLocaleDateString('en-US', { month: 'long', year: 'numeric' })
  : 'Recently';
---

<section class="market-insights">
  <div class="container">
    <div class="section-header">
      <h2>Live Market Data — Updated Monthly</h2>
      <p class="section-subtitle">
        Real numbers from recent sales across Burlington, Mercer, and Middlesex Counties. Data through {lastUpdated}.
      </p>
    </div>

    <div class="insights-grid">
      <!-- Card 1: County Median Prices (live) -->
      <a href="/market/" class="insight-card">
        <div class="card-icon">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none">
            <path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h3 class="card-title">Median Sale Price by County</h3>
        <div class="card-stats">
          {counties.map((county) => (
            <div class="stat-item">
              <div class="stat-label">{county.region}</div>
              <div class="stat-value">{formatCurrency(county.median_sale_price)}</div>
              {county.median_sale_price_yoy !== null && (
                <div class={`stat-sublabel ${county.median_sale_price_yoy >= 0 ? 'positive' : 'negative'}`}>
                  {fmtYoY(county.median_sale_price_yoy)} year-over-year
                </div>
              )}
            </div>
          ))}
        </div>
        <div class="card-source">View all market data →</div>
      </a>

      <!-- Card 2: Market Health Breakdown (live) -->
      <a href="/tools/should-i-sell-now/" class="insight-card">
        <div class="card-icon">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none">
            <path d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h3 class="card-title">Market Conditions Across {allZipcodes.length} Zip Codes</h3>
        <div class="card-stats">
          <div class="stat-item">
            <div class="stat-label">Seller's Markets</div>
            <div class="stat-value seller-val">{sellerCount}</div>
            <div class="stat-sublabel">{Math.round((sellerCount / allZipcodes.length) * 100)}% of tracked areas</div>
          </div>
          <div class="stat-item">
            <div class="stat-label">Balanced Markets</div>
            <div class="stat-value">{balancedCount}</div>
            <div class="stat-sublabel">{Math.round((balancedCount / allZipcodes.length) * 100)}% of tracked areas</div>
          </div>
          <div class="stat-item">
            <div class="stat-label">Buyer's Markets</div>
            <div class="stat-value">{buyerCount}</div>
            <div class="stat-sublabel">{Math.round((buyerCount / allZipcodes.length) * 100)}% of tracked areas</div>
          </div>
        </div>
        <div class="card-source">Check your area's timing →</div>
      </a>

      <!-- Card 3: Hottest Towns (live) -->
      <a href="/areas/" class="insight-card">
        <div class="card-icon">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none">
            <path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h3 class="card-title">
          {movers.hotMarkets.length > 0 ? 'Fastest-Appreciating Towns' : 'Fastest-Selling Towns'}
        </h3>
        <div class="card-stats">
          {hotTowns.slice(0, 5).map((town, i) => (
            <div class="stat-item">
              <div class="stat-label">{i + 1}. {town.name}</div>
              <div class="stat-value">{formatCurrency(town.medianPrice)}</div>
              <div class="stat-sublabel">
                {movers.hotMarkets.length > 0
                  ? `+${town.priceYoY?.toFixed(1)}% YoY`
                  : `${town.medianDom} days avg`}
                {' '}· {town.county.replace(' County', '')}
              </div>
            </div>
          ))}
        </div>
        <div class="card-source">Explore all towns →</div>
      </a>
    </div>

    <p class="disclaimer">
      Market data sourced from recent transactions via Redfin public data. Updated monthly.
      Contact Steven for a personalized analysis of your specific property.
    </p>
  </div>
</section>

<style>
  .market-insights {
    padding: var(--space-12) 0;
    background-color: var(--off-white);
  }

  .section-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto var(--space-10);
  }

  .section-header h2 {
    font-size: var(--text-3xl);
    color: var(--text-primary);
    margin-bottom: var(--space-3);
  }

  .section-subtitle {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  .insights-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-bottom: var(--space-6);
  }

  @media (min-width: 768px) {
    .insights-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .insights-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .insight-card {
    background: var(--surface-1);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    transition: all var(--transition-base);
    text-decoration: none;
    color: inherit;
  }

  .insight-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
    border-color: var(--accent);
  }

  .card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    background: var(--accent-wash-strong);
    border: 1px solid var(--accent-line);
    border-radius: var(--radius-full);
    color: var(--white);
    margin-bottom: var(--space-2);
  }

  .card-title {
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    margin-bottom: var(--space-3);
  }

  .card-stats {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex: 1;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-color);
  }

  .stat-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .stat-label {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    font-weight: var(--font-medium);
  }

  .stat-value {
    font-family: var(--font-heading);
    font-variant-numeric: tabular-nums;
    font-size: var(--text-2xl);
    color: var(--text-primary);
    font-weight: var(--font-bold);
    white-space: nowrap;
  }

  .seller-val { color: var(--accent-green); }

  .stat-sublabel {
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  .stat-sublabel.positive { color: var(--accent-green); font-weight: 600; }
  .stat-sublabel.negative { color: var(--accent-red); font-weight: 600; }

  .card-source {
    font-size: var(--text-sm);
    color: var(--text-primary);
    font-weight: 600;
    padding-top: var(--space-2);
    border-top: 1px solid var(--border-color);
  }

  .disclaimer {
    /* Rokkitt ships no italic; the browser would fake one. Meta text uses the UI face, which has a real italic. */
    font-family: var(--font-ui);
    text-align: center;
    font-size: var(--text-sm);
    color: var(--text-secondary);
    font-style: italic;
    max-width: 700px;
    margin: 0 auto;
    line-height: var(--leading-relaxed);
  }
</style>
