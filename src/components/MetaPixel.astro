---
/**
 * Meta (Facebook) Pixel — the single source of the pixel ID.
 *
 * Extracted from BaseLayout so the marketing site and the standalone paid-traffic
 * landing layout share one ID. Two inline copies of a pixel snippet is how you end
 * up optimising two different pixels and not noticing for a month.
 *
 * The snippet is self-guarding: `if(f.fbq)return` means including it twice on one
 * page is harmless. But only ever render it ONCE per page — a second `fbq('init')`
 * with the same ID would double-count PageView.
 *
 * NOT consent-gated, unlike GA4 (see consent.ts loadGA4) and Matomo (which boots
 * with `requireCookieConsent`). That is a deliberate, owner-approved decision:
 * gating it would break attribution for paid campaigns, which is the only reason
 * the pixel exists. The privacy policy discloses Meta explicitly to match.
 *
 * Events beyond PageView are fired from page code — see src/pages/cash-offer.astro,
 * where the standard `Lead` event is reserved for genuinely qualified sellers.
 */
const PIXEL_ID = '928988636918000';
---

<!-- Meta Pixel Code -->
<script is:inline define:vars={{ PIXEL_ID }}>
  !function(f,b,e,v,n,t,s)
  {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
  n.callMethod.apply(n,arguments):n.queue.push(arguments)};
  if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
  n.queue=[];t=b.createElement(e);t.async=!0;
  t.src=v;s=b.getElementsByTagName(e)[0];
  s.parentNode.insertBefore(t,s)}(window, document,'script',
  'https://connect.facebook.net/en_US/fbevents.js');
  fbq('init', PIXEL_ID);
  fbq('track', 'PageView');
</script>
<noscript><img height="1" width="1" style="display:none"
src={`https://www.facebook.com/tr?id=${PIXEL_ID}&ev=PageView&noscript=1`}
/></noscript>
<!-- End Meta Pixel Code -->
