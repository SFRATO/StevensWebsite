---
/**
 * TestimonialCard — Client testimonial with star rating, quote, and attribution.
 * Fires a Matomo engagement event when scrolled into view.
 */
interface Props {
  quote: string;
  author: string;
  location: string;
  rating?: number;
  context?: 'selling' | 'buying' | 'both';
}

const { quote, author, location, rating = 5, context } = Astro.props;
---

<div class="testimonial-card" data-author={author} data-location={location}>
  <div class="stars" aria-label={`${rating} out of 5 stars`}>
    {Array.from({ length: rating }).map(() => (
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
      </svg>
    ))}
  </div>
  <blockquote class="quote">"{quote}"</blockquote>
  <footer class="attribution">
    <span class="author">{author}</span>
    <span class="sep">·</span>
    <span class="location">{location}</span>
    {context && <span class="context-tag">{context === 'selling' ? 'Seller' : context === 'buying' ? 'Buyer' : 'Buyer & Seller'}</span>}
  </footer>
</div>

<script>
  import { trackEvent } from '@utils/analytics';

  document.addEventListener('astro:page-load', () => {
    const cards = document.querySelectorAll<HTMLElement>('.testimonial-card:not([data-observed])');
    if (!cards.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const card = entry.target as HTMLElement;
            const author = card.dataset.author ?? '';
            const location = card.dataset.location ?? '';
            trackEvent('Engagement', 'Testimonial Viewed', `${author} - ${location}`);
            observer.unobserve(card);
          }
        });
      },
      { threshold: 0.5 }
    );

    cards.forEach((card) => {
      card.dataset.observed = '1';
      observer.observe(card);
    });
  });
</script>

<style>
  .testimonial-card {
    background: var(--surface-1);
    border: 1px solid var(--rule);
    border-radius: 0.75rem;
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .stars {
    display: flex;
    gap: 2px;
    color: var(--text-primary);
  }

  .quote {
    font-size: var(--text-sm);
    color: var(--text-primary);
    line-height: 1.7;
    margin: 0;
    /* Deliberately upright: Rokkitt has no italic, and a synthesized slant on a
       slab serif at quote size is visibly wrong. The quotation marks and the
       serif itself carry the voice. */
  }

  .attribution {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: auto;
  }

  .author {
    font-weight: 700;
    font-size: var(--text-sm);
    color: var(--text-primary);
  }

  .sep {
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }

  .location {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .context-tag {
    margin-left: auto;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background: var(--accent-wash);
    color: var(--text-primary);
    font-size: 0.7rem;
    font-weight: 700;
  }
</style>
