---
/**
 * ExitIntentPopup Component
 *
 * Two-step, stat-led lead capture mounted globally in BaseLayout.
 *
 * Step 1 asks for one thing — an email — against a real market stat for the
 * page the visitor is on. The lead is created the moment step 1 submits, so
 * nobody is lost to step 2.
 *
 * Step 2 asks intent + timeline *after* they've committed, and updates the
 * lead in place. Nothing is pre-selected: an unanswered question posts nothing
 * so the server keeps its honest default rather than recording a guess.
 *
 * Location comes from the pathname via resolveLocationFromPath() — the
 * component has no page props but every route encodes its geography.
 */
import { resolveLocationFromPath, formatLocationStat } from '@utils/pageLocation';
import { computeMoversAndShakers, formatPercent } from '@utils/market-analysis';

interface Props {
  hideOnPages?: string[];
}

const { hideOnPages = ['/thank-you', '/contact'] } = Astro.props;

const currentPath = Astro.url.pathname;
const shouldHide = hideOnPages.some((page) => currentPath.startsWith(page));

const location = resolveLocationFromPath(currentPath);
const statLine = location ? formatLocationStat(location) : null;

// A known zip becomes a hidden field — one less thing to type. County-scoped
// pages span many towns, so those still ask.
const knownZip = location?.zipcode ?? null;

// Copy varies by how specific the page is.
let eyebrow: string;
let headline: string;
let subcopy: string;
let fallbackStat: string | null = null;

if (location && statLine) {
  eyebrow = location.scope === 'county' ? location.label : `${location.label}, NJ`;
  headline = `Want next month's ${location.label} numbers?`;
  subcopy = `A free monthly ${location.label} market update — median price, days on market, and what it means if you're thinking of selling. One email a month.`;
} else {
  // No geography (home, about, tools) or no data for this area: lead with the
  // strongest real number we have across the coverage area.
  const hottest = computeMoversAndShakers(1).hotMarkets[0];
  eyebrow = 'New Jersey market';
  headline = "Want your town's numbers?";
  subcopy =
    'A free monthly market update for your area — median price, days on market, and what it means if you\'re thinking of selling. One email a month.';
  if (hottest && hottest.priceYoY !== null) {
    fallbackStat = `${hottest.name} is leading the area at ${formatPercent(hottest.priceYoY)} YoY`;
  }
}

const displayStat = statLine ?? fallbackStat;
---

{!shouldHide && (
  <div
    class="exit-popup-overlay"
    id="exit-popup"
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
    aria-labelledby="exit-popup-title"
  >
    <div class="exit-popup">
      <button class="popup-close" aria-label="Close popup" id="exit-popup-close">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6 18L18 6M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <!-- Step 1: the ask -->
      <div class="popup-step" id="exit-popup-step1">
        <div class="stat-hook">
          <p class="stat-eyebrow">{eyebrow}</p>
          {displayStat && <p class="stat-line">{displayStat}</p>}
        </div>

        <div class="popup-body">
          <h2 id="exit-popup-title">{headline}</h2>
          <p class="popup-sub">{subcopy}</p>

          <form class="popup-form" id="exit-intent-form" novalidate>
            <input type="hidden" name="form-name" value="market-report" />
            <input type="hidden" name="source-location" value="Exit Intent Popup" />
            <input type="hidden" name="address" value="Not provided" />
            {knownZip && <input type="hidden" name="zipcode" value={knownZip} />}
            <p class="visually-hidden-field">
              <label>Don't fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
            </p>

            <div class={knownZip ? 'form-row single' : 'form-row'}>
              <input
                type="email"
                name="email"
                placeholder="Email address"
                required
                autocomplete="email"
                aria-label="Email address"
                class="popup-input"
              />
              {!knownZip && (
                <input
                  type="text"
                  name="zipcode"
                  placeholder="Zip code"
                  inputmode="numeric"
                  pattern="[0-9]{5}"
                  maxlength="5"
                  required
                  autocomplete="postal-code"
                  aria-label="Zip code"
                  class="popup-input zip-input"
                />
              )}
            </div>

            <p class="form-error" id="exit-popup-error" role="alert" hidden></p>

            <button type="submit" class="popup-submit">Send Me The Numbers</button>

            <p class="privacy-note">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              No spam. Unsubscribe anytime.
            </p>
          </form>
        </div>
      </div>

      <!-- Step 2: qualification, after they've committed -->
      <div class="popup-step" id="exit-popup-step2" hidden>
        <div class="popup-body">
          <div class="step2-confirm">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>You're on the list.</span>
          </div>

          <h2 id="exit-popup-step2-title">Two quick questions?</h2>
          <p class="popup-sub">Optional — but it lets me send you numbers that actually apply to you.</p>

          <form class="popup-form" id="exit-qualify-form" novalidate>
            <div class="chip-question">
              <span class="question-label" id="q-interest-label">What best describes you?</span>
              <div class="chip-options chip-3" role="radiogroup" aria-labelledby="q-interest-label">
                <label class="chip">
                  <input type="radio" name="interest" value="selling" />
                  <span>Thinking of selling</span>
                </label>
                <label class="chip">
                  <input type="radio" name="interest" value="buying" />
                  <span>Looking to buy</span>
                </label>
                <label class="chip">
                  <input type="radio" name="interest" value="home-value" />
                  <span>Checking home value</span>
                </label>
              </div>
            </div>

            <div class="chip-question">
              <span class="question-label" id="q-timeline-label">When are you thinking of making a move?</span>
              <div class="chip-options chip-2" role="radiogroup" aria-labelledby="q-timeline-label">
                <label class="chip">
                  <input type="radio" name="timeline" value="within-30-days" />
                  <span>Within 30 days</span>
                </label>
                <label class="chip">
                  <input type="radio" name="timeline" value="1-3-months" />
                  <span>1–3 months</span>
                </label>
                <label class="chip">
                  <input type="radio" name="timeline" value="3-6-months" />
                  <span>3–6 months</span>
                </label>
                <label class="chip">
                  <input type="radio" name="timeline" value="6-plus-months" />
                  <span>Just curious</span>
                </label>
              </div>
            </div>

            <input
              type="text"
              name="name"
              placeholder="Your name (optional)"
              autocomplete="name"
              aria-label="Your name"
              class="popup-input"
            />

            <div class="step2-actions">
              <button type="button" class="popup-skip" id="exit-popup-skip">Skip</button>
              <button type="submit" class="popup-submit">Done</button>
            </div>
          </form>
        </div>
      </div>

      <!-- Final confirmation -->
      <div class="popup-step" id="exit-popup-success" hidden>
        <div class="popup-body popup-success">
          <div class="success-icon">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h2 id="exit-popup-success-title">You're all set</h2>
          <p class="popup-sub">Your first market update is on its way. Watch your inbox.</p>
        </div>
      </div>
    </div>
  </div>
)}

<script>
  import { trackEvent } from '@utils/analytics';
  import { getConsent } from '@utils/consent';
  import { identifyLead, isKnownLead } from '@utils/leadIdentity';

  const STORAGE_KEY = 'exit_popup_shown';
  const SESSION_START_KEY = 'exit_popup_session_start';

  let docListenersBound = false;
  let popupShown = false;
  let mobileTimeout: ReturnType<typeof setTimeout> | undefined;

  /** Element the focus was on before the dialog opened, so we can restore it. */
  let lastFocused: HTMLElement | null = null;

  /** Token + email from step 1, needed to update the lead in step 2. */
  let leadToken: string | null = null;
  let leadEmail = '';
  let leadZip = '';

  // Query fresh each call — the popup element is re-rendered on view transitions.
  const getPopup = () => document.getElementById('exit-popup');

  const FOCUSABLE =
    'button:not([disabled]), [href], input:not([type="hidden"]), select, textarea, [tabindex]:not([tabindex="-1"])';

  /** Visible focusable elements inside the dialog (hidden steps are excluded). */
  const focusables = (popup: HTMLElement): HTMLElement[] =>
    Array.from(popup.querySelectorAll<HTMLElement>(FOCUSABLE)).filter(
      (el) => el.offsetParent !== null || el === document.activeElement
    );

  /**
   * Open the dialog.
   *
   * `manual: true` means a visitor deliberately asked for it (the hero's
   * "What's your town worth?" button, via the sf:open-lead-popup event). That
   * bypasses every suppression guard, because a click is not a nag:
   *
   *  - popupShown / exit_popup_shown — the once-per-session limit exists to stop
   *    US interrupting THEM; it should never make a button look broken.
   *  - isKnownLead() — a returning lead re-submitting is handled server-side as
   *    an update, not a duplicate (see handle-form-submission).
   *  - getConsent() === null — a first-time visitor still has the cookie banner
   *    up, and that is exactly when they are most likely to click. Refusing here
   *    would break the button for the most common case.
   *
   * Automatic triggers keep all four guards.
   */
  const openPopup = ({ manual = false }: { manual?: boolean } = {}) => {
    if (!manual) {
      if (popupShown || sessionStorage.getItem(STORAGE_KEY)) return;

      // Don't stack modals: the cookie decision comes first, and there is no point
      // asking a visitor who already gave us their email.
      if (getConsent() === null || isKnownLead()) return;
    }

    const popup = getPopup();
    if (!popup) return;

    popupShown = true;
    // NOTE: do NOT set the session suppression flag on view — only on a successful
    // submit or an explicit dismiss (see hidePopup / submit handler). Setting it on
    // view previously meant a failed submit could never re-prompt.

    // showStep() is never rewound, so a second manual open would otherwise land
    // on whichever step the last visit ended on — usually the success panel.
    if (manual) {
      showStep('exit-popup-step1');
      setError(null);
    }

    lastFocused = document.activeElement as HTMLElement | null;

    popup.classList.add('visible');
    popup.setAttribute('aria-hidden', 'false');

    const firstInput = popup.querySelector<HTMLElement>('input[type="email"]');
    (firstInput ?? popup.querySelector<HTMLElement>('.popup-close'))?.focus();

    trackEvent('Engagement', 'Popup View', manual ? 'Hero CTA' : 'Exit Intent');
  };

  /** Automatic triggers only. Kept as a name so trigger call sites read clearly. */
  const showPopup = () => openPopup();

  const hidePopup = () => {
    const popup = getPopup();
    if (!popup) return;
    popup.classList.remove('visible');
    popup.setAttribute('aria-hidden', 'true');
    // Suppress for the rest of the session once dismissed (or auto-closed after a
    // successful submit) so we don't re-nag the visitor.
    sessionStorage.setItem(STORAGE_KEY, 'true');

    lastFocused?.focus?.();
    lastFocused = null;
  };

  /** Swap which step is on screen, retitle the dialog, and move focus into it. */
  const showStep = (id: string) => {
    const popup = getPopup();
    if (!popup) return;

    for (const step of popup.querySelectorAll<HTMLElement>('.popup-step')) {
      step.hidden = step.id !== id;
    }

    const active = document.getElementById(id);
    if (!active) return;

    // Keep the dialog's accessible name pointing at the heading that is actually
    // on screen — otherwise it resolves to a hidden element and reads as unnamed.
    const heading = active.querySelector<HTMLElement>('h2[id]');
    if (heading) popup.setAttribute('aria-labelledby', heading.id);

    active.querySelector<HTMLElement>(FOCUSABLE)?.focus();
  };

  const setError = (message: string | null) => {
    const el = document.getElementById('exit-popup-error');
    if (!el) return;
    el.textContent = message ?? '';
    el.hidden = !message;
  };

  /** Same shape as RegistrationGate's — a failure the server can explain. */
  class SubmitError extends Error {
    constructor(
      message: string,
      readonly code?: string,
      readonly field?: string,
      readonly suggestion?: string,
      readonly canOverride?: boolean,
    ) {
      super(message);
    }
  }

  /** Address the server softly rejected; re-submitting it sends the override. */
  let lastRejectedEmail: string | null = null;

  const post = async (body: Record<string, string>) => {
    const response = await fetch('/api/market-report', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams(body).toString(),
    });
    if (!response.ok) {
      const p = (await response.json().catch(() => ({}))) as Record<string, unknown>;
      throw new SubmitError(
        (p.error as string) || `Submission failed (${response.status})`,
        p.code as string | undefined,
        p.field as string | undefined,
        p.suggestion as string | undefined,
        p.canOverride as boolean | undefined,
      );
    }
    return (await response.json().catch(() => ({}))) as { lead_token?: string };
  };

  /**
   * Mobile: show after ~30s of CUMULATIVE engagement across the whole session.
   * Astro view transitions re-run init on every page, so a per-page timer never
   * fired for multi-page mobile visitors — track a session start instead.
   *
   * `minDelay` gives the visitor a beat after they dismiss the cookie banner,
   * so accepting cookies doesn't slam a second modal in their face.
   */
  const armMobileTimer = (minDelay = 0) => {
    if (window.innerWidth >= 768 || popupShown) return;

    let sessionStart = parseInt(sessionStorage.getItem(SESSION_START_KEY) || '0', 10);
    if (!sessionStart) {
      sessionStart = Date.now();
      sessionStorage.setItem(SESSION_START_KEY, String(sessionStart));
    }

    const elapsed = Math.max(0, 30000 - (Date.now() - sessionStart));
    if (mobileTimeout) clearTimeout(mobileTimeout);
    mobileTimeout = setTimeout(() => {
      if (!popupShown && document.visibilityState === 'visible') showPopup();
    }, Math.max(elapsed, minDelay));
  };

  // Document/window-level listeners bound once (they survive view transitions).
  const bindGlobalListenersOnce = () => {
    if (docListenersBound) return;
    docListenersBound = true;

    // Deliberate open, dispatched by the homepage hero's "What's your town
    // worth?" button. Same cross-component pattern consent.ts uses for
    // sf:consent-reset. Always opens — see openPopup()'s manual branch.
    window.addEventListener('sf:open-lead-popup', () => openPopup({ manual: true }));

    // A visitor who reaches a trigger before deciding on cookies is skipped by
    // showPopup()'s guard, and on mobile that consumes the one-shot timer. Once
    // they decide, re-arm the timer and re-check scroll depth so they aren't
    // silently excluded for the rest of the session.
    window.addEventListener('sf:consent', () => {
      if (popupShown || sessionStorage.getItem(STORAGE_KEY)) return;

      armMobileTimer(5000);

      // Same grace period on desktop: dismissing one dialog should not
      // immediately summon the next.
      setTimeout(() => {
        if (popupShown) return;
        const doc = document.documentElement;
        const denom = doc.scrollHeight - window.innerHeight;
        if (denom > 0 && doc.scrollTop / denom >= 0.6) showPopup();
      }, 5000);
    });

    // Exit intent detection (desktop): mouse leaves viewport from top
    document.addEventListener('mouseout', (e) => {
      if (e.clientY <= 0 && !popupShown) showPopup();
    });

    // Scroll-depth trigger (touch devices have no mouseout): show once the visitor
    // has scrolled past ~60% of the page — a strong mobile engagement signal.
    document.addEventListener(
      'scroll',
      () => {
        if (popupShown) return;
        const doc = document.documentElement;
        const denom = doc.scrollHeight - window.innerHeight;
        if (denom > 0 && doc.scrollTop / denom >= 0.6) showPopup();
      },
      { passive: true }
    );

    // Escape to close, Tab confined to the dialog while it's open.
    document.addEventListener('keydown', (e) => {
      const popup = getPopup();
      if (!popup?.classList.contains('visible')) return;

      if (e.key === 'Escape') {
        hidePopup();
        return;
      }

      if (e.key !== 'Tab') return;

      const items = focusables(popup);
      if (items.length === 0) return;

      const first = items[0];
      const last = items[items.length - 1];
      const active = document.activeElement as HTMLElement | null;

      // Wrap at both ends, and pull focus back in if it has escaped the dialog.
      if (e.shiftKey && (active === first || !popup.contains(active))) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && (active === last || !popup.contains(active))) {
        e.preventDefault();
        first.focus();
      }
    });

    window.addEventListener('beforeunload', () => {
      if (mobileTimeout) clearTimeout(mobileTimeout);
    });
  };

  const bindStep1 = (form: HTMLFormElement) => {
    if (form.dataset.bound) return;
    form.dataset.bound = '1';

    form.addEventListener(
      'focusin',
      () => trackEvent('Lead', 'Form Start', 'Exit Intent Popup'),
      { once: true }
    );

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      setError(null);

      const formData = new FormData(form);
      const email = String(formData.get('email') ?? '').trim();
      const zipcode = String(formData.get('zipcode') ?? '').trim();

      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        setError('Please enter a valid email address.');
        form.querySelector<HTMLElement>('input[type="email"]')?.focus();
        return;
      }
      if (!/^\d{5}$/.test(zipcode)) {
        setError('Please enter a 5-digit zip code.');
        form.querySelector<HTMLElement>('.zip-input')?.focus();
        return;
      }

      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const originalLabel = submitBtn?.textContent ?? 'Send Me The Numbers';
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending...';
      }

      try {
        const result = await post({
          'form-name': 'market-report',
          'source-location': 'Exit Intent Popup',
          address: 'Not provided',
          'bot-field': String(formData.get('bot-field') ?? ''),
          // Honour a deliberate re-submit of a softly-rejected address.
          'email-confirmed': lastRejectedEmail && lastRejectedEmail === email ? '1' : '',
          email,
          zipcode,
          // Real name is asked for in step 2; the server requires a non-empty one.
          name: 'Website Visitor',
        });

        leadToken = result.lead_token ?? null;
        leadEmail = email;
        leadZip = zipcode;

        // Suppress for the session — the lead exists now even if step 2 is skipped.
        sessionStorage.setItem(STORAGE_KEY, 'true');
        await identifyLead(email, leadToken);

        trackEvent('Lead', 'Exit Intent Popup');

        showStep('exit-popup-step2');
        trackEvent('Engagement', 'Popup Step 2 Shown');
      } catch (err) {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = originalLabel;
        }

        // Show what the server actually said about the address, and offer the
        // correction. Previously any 400 became "try again", which is advice
        // that cannot work for a permanently-invalid address.
        if (err instanceof SubmitError && err.field === 'email') {
          setError(err.message);
          lastRejectedEmail = err.canOverride ? email : null;

          if (err.suggestion) {
            const el = document.getElementById('exit-popup-error');
            const input = form.querySelector<HTMLInputElement>('input[name="email"]');
            if (el && input) {
              const fix = document.createElement('button');
              fix.type = 'button';
              fix.className = 'popup-suggest';
              fix.textContent = `Use ${err.suggestion}`;
              fix.addEventListener('click', () => {
                input.value = err.suggestion!;
                lastRejectedEmail = null;
                setError(null);
                form.requestSubmit();
              });
              el.append(document.createTextNode(' '), fix);
            }
          }

          trackEvent('Lead', 'Exit Popup Email Rejected', err.code ?? 'unknown');
          return;
        }

        setError("We couldn't save that just now. Please try again in a moment.");
      }
    });
  };

  const finish = () => {
    showStep('exit-popup-success');
    setTimeout(hidePopup, 2500);
  };

  const bindStep2 = (form: HTMLFormElement) => {
    if (form.dataset.bound) return;
    form.dataset.bound = '1';

    form.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.name === 'interest') {
        trackEvent('Engagement', 'Exit Popup Intent Selected', target.value);
      }
      if (target.name === 'timeline') {
        trackEvent('Engagement', 'Exit Popup Timeline Selected', target.value);
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const interest = String(formData.get('interest') ?? '');
      const timeline = String(formData.get('timeline') ?? '');
      const name = String(formData.get('name') ?? '').trim();

      // Nothing answered — same outcome as Skip, no pointless round trip.
      if (!interest && !timeline && !name) {
        trackEvent('Engagement', 'Popup Step 2 Skipped', 'Empty');
        finish();
        return;
      }

      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Saving...';
      }

      const payload: Record<string, string> = {
        'form-name': 'market-report',
        'source-location': 'Exit Intent Popup',
        qualify: '1',
        email: leadEmail,
        zipcode: leadZip,
        name: name || 'Website Visitor',
      };
      if (leadToken) payload.lead_token = leadToken;
      // Only send what they actually chose — an omitted field must not be guessed.
      if (interest) payload.interest = interest;
      if (timeline) payload.timeline = timeline;

      try {
        await post(payload);
        trackEvent('Engagement', 'Popup Step 2 Completed', interest || 'unspecified');
      } catch {
        // The lead already landed in step 1; qualification is a bonus, so a
        // failure here should not be shown as an error to the visitor.
        trackEvent('Engagement', 'Popup Step 2 Failed');
      }

      finish();
    });
  };

  const initExitPopup = () => {
    const popup = getPopup();
    const closeBtn = document.getElementById('exit-popup-close');
    const step1Form = document.getElementById('exit-intent-form') as HTMLFormElement | null;
    const step2Form = document.getElementById('exit-qualify-form') as HTMLFormElement | null;
    const skipBtn = document.getElementById('exit-popup-skip');

    if (!popup || !closeBtn || !step1Form) return;

    bindGlobalListenersOnce();

    /*
      Element listeners are bound UNCONDITIONALLY.

      They used to sit behind the suppression check below, which was safe only
      while nothing could open the dialog in a suppressed state. The hero button
      can, so binding late would produce a dialog with a dead ✕ and a dead
      submit button — openable, but not closable or usable.

      Only the automatic mobile timer is gated.
    */
    if (!closeBtn.dataset.bound) {
      closeBtn.dataset.bound = '1';
      closeBtn.addEventListener('click', hidePopup);
    }

    /*
      No backdrop-click dismissal, deliberately. Clicking outside is too easy to
      do by accident on a form a visitor has started filling in; they must use
      the ✕ or Escape. (Escape stays — removing it would trap keyboard and
      screen-reader users, WCAG 2.1.2.)
    */

    if (skipBtn && !skipBtn.dataset.bound) {
      skipBtn.dataset.bound = '1';
      skipBtn.addEventListener('click', () => {
        trackEvent('Engagement', 'Popup Step 2 Skipped');
        finish();
      });
    }

    bindStep1(step1Form);
    if (step2Form) bindStep2(step2Form);

    // Automatic triggers only: don't re-nag someone who already saw it,
    // converted, or is a known lead. The hero button still works for all three.
    if (sessionStorage.getItem(STORAGE_KEY) || isKnownLead()) return;

    armMobileTimer();
  };

  // Fires on initial load and after every view-transition navigation.
