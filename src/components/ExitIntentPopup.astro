---
/**
 * ExitIntentPopup Component
 * Simplified lead capture that triggers on exit intent
 * Shows once per session, respects dismissal
 */
interface Props {
  hideOnPages?: string[];
}

const {
  hideOnPages = ['/thank-you', '/contact'],
} = Astro.props;

// Check if current page should hide the popup
const currentPath = Astro.url.pathname;
const shouldHide = hideOnPages.some(page => currentPath.startsWith(page));
---

{!shouldHide && (
  <div class="exit-popup-overlay" id="exit-popup" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="exit-popup-title">
    <div class="exit-popup">
      <button class="popup-close" aria-label="Close popup" id="exit-popup-close">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
          <path d="M6 18L18 6M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <div class="popup-content">
        <div class="popup-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
            <path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>

        <h2 id="exit-popup-title">Before You Go...</h2>
        <p>Get a free market update for your area — no spam, just helpful data when conditions change.</p>

        <form
          class="popup-form"
          id="exit-intent-form"
        >
          <input type="hidden" name="form-name" value="market-report" />
          <input type="hidden" name="source-location" value="Exit Intent Popup" />
          <input type="hidden" name="address" value="Not provided" />
          <p class="hidden">
            <label>Don't fill this out: <input name="bot-field" /></label>
          </p>

          <!-- Intent Question -->
          <div class="intent-question">
            <label class="question-label">What best describes you?</label>
            <div class="intent-options">
              <label class="intent-option">
                <input type="radio" name="interest" value="selling" />
                <span>Thinking of Selling</span>
              </label>
              <label class="intent-option">
                <input type="radio" name="interest" value="buying" />
                <span>Looking to Buy</span>
              </label>
              <label class="intent-option">
                <input type="radio" name="interest" value="home-value" checked />
                <span>Checking Home Value</span>
              </label>
            </div>
          </div>

          <!-- Timeline Question -->
          <div class="timeline-question">
            <label class="question-label">When are you thinking of making a move?</label>
            <div class="timeline-options">
              <label class="timeline-option">
                <input type="radio" name="timeline" value="within-30-days" />
                <span>Within 30 days</span>
              </label>
              <label class="timeline-option">
                <input type="radio" name="timeline" value="1-3-months" />
                <span>1-3 months</span>
              </label>
              <label class="timeline-option">
                <input type="radio" name="timeline" value="3-6-months" checked />
                <span>3-6 months</span>
              </label>
              <label class="timeline-option">
                <input type="radio" name="timeline" value="6-plus-months" />
                <span>Just curious</span>
              </label>
            </div>
          </div>

          <input
            type="text"
            name="name"
            placeholder="Your name (optional)"
            aria-label="Your name"
            class="popup-input"
          />

          <div class="form-row">
            <input
              type="email"
              name="email"
              placeholder="Email address"
              required
              aria-label="Email address"
            />
            <input
              type="text"
              name="zipcode"
              placeholder="Zip code"
              pattern="[0-9]{5}"
              maxlength="5"
              required
              aria-label="Zip code"
            />
          </div>

          <button type="submit" class="popup-submit">
            Get My Market Update
          </button>

          <p class="privacy-note">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none">
              <path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            No spam. Unsubscribe anytime.
          </p>
        </form>

        <div class="popup-success" id="exit-popup-success" style="display: none;">
          <div class="success-icon">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none">
              <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3>You're Signed Up!</h3>
          <p>You'll receive market updates when data changes in your area.</p>
        </div>
      </div>
    </div>
  </div>
)}

<script>
  import { trackEvent } from '@utils/analytics';

  // Session storage key — popup shows once per session
  const STORAGE_KEY = 'exit_popup_shown';

  let docListenersBound = false;
  let popupShown = false;
  let mobileTimeout: ReturnType<typeof setTimeout> | undefined;

  // Query fresh each call — the popup element is re-rendered on view transitions.
  const getPopup = () => document.getElementById('exit-popup');

  const showPopup = () => {
    if (popupShown || sessionStorage.getItem(STORAGE_KEY)) return;
    const popup = getPopup();
    if (!popup) return;

    popupShown = true;
    // NOTE: do NOT set the session suppression flag on view — only on a successful
    // submit or an explicit dismiss (see hidePopup / submit handler). Setting it on
    // view previously meant a failed submit could never re-prompt.

    popup.classList.add('visible');
    popup.setAttribute('aria-hidden', 'false');

    // Focus trap
    const firstInput = popup.querySelector('input');
    if (firstInput) (firstInput as HTMLElement).focus();

    // Track popup view (engagement, not a conversion)
    trackEvent('Engagement', 'Popup View', 'Exit Intent');
  };

  const hidePopup = () => {
    const popup = getPopup();
    if (!popup) return;
    popup.classList.remove('visible');
    popup.setAttribute('aria-hidden', 'true');
    // Suppress for the rest of the session once dismissed (or auto-closed after a
    // successful submit) so we don't re-nag the visitor.
    sessionStorage.setItem(STORAGE_KEY, 'true');
  };

  // Document/window-level listeners bound once (they survive view transitions).
  const bindGlobalListenersOnce = () => {
    if (docListenersBound) return;
    docListenersBound = true;

    // Exit intent detection (desktop): mouse leaves viewport from top
    document.addEventListener('mouseout', (e) => {
      if (e.clientY <= 0 && !popupShown) showPopup();
    });

    // Scroll-depth trigger (touch devices have no mouseout): show once the visitor
    // has scrolled past ~60% of the page — a strong mobile engagement signal.
    document.addEventListener('scroll', () => {
      if (popupShown) return;
      const doc = document.documentElement;
      const denom = doc.scrollHeight - window.innerHeight;
      if (denom > 0 && doc.scrollTop / denom >= 0.6) showPopup();
    }, { passive: true });

    // Close on escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && getPopup()?.classList.contains('visible')) {
        hidePopup();
      }
    });

    // Cleanup
    window.addEventListener('beforeunload', () => {
      if (mobileTimeout) clearTimeout(mobileTimeout);
    });
  };

  const initExitPopup = () => {
    // Nothing to do if already shown/converted this session.
    if (sessionStorage.getItem(STORAGE_KEY)) return;

    const popup = getPopup();
    const closeBtn = document.getElementById('exit-popup-close');
    const form = document.getElementById('exit-intent-form') as HTMLFormElement | null;
    const successMsg = document.getElementById('exit-popup-success');

    if (!popup || !closeBtn || !form) return;

    bindGlobalListenersOnce();

    // Mobile: show after ~30s of CUMULATIVE engagement across the whole session.
    // Astro view transitions re-run this init on every page, so a per-page timer
    // never fired for multi-page mobile visitors — track a session start instead.
    if (window.innerWidth < 768 && !popupShown) {
      const SESSION_START_KEY = 'exit_popup_session_start';
      let sessionStart = parseInt(sessionStorage.getItem(SESSION_START_KEY) || '0', 10);
      if (!sessionStart) {
        sessionStart = Date.now();
        sessionStorage.setItem(SESSION_START_KEY, String(sessionStart));
      }
      const remaining = Math.max(0, 30000 - (Date.now() - sessionStart));
      if (mobileTimeout) clearTimeout(mobileTimeout);
      mobileTimeout = setTimeout(() => {
        if (!popupShown && document.visibilityState === 'visible') showPopup();
      }, remaining);
    }

    // Element-level listeners — bind once per freshly-rendered element.
    if (!closeBtn.dataset.bound) {
      closeBtn.dataset.bound = '1';
      closeBtn.addEventListener('click', hidePopup);
    }

    if (!popup.dataset.bound) {
      popup.dataset.bound = '1';
      popup.addEventListener('click', (e) => {
        if (e.target === popup) hidePopup();
      });
    }

    if (!form.dataset.bound) {
      form.dataset.bound = '1';

      // Track form start on first field interaction
      form.addEventListener(
        'focusin',
        () => trackEvent('Lead', 'Form Start', 'Exit Intent Popup'),
        { once: true }
      );

      // Track intent and timeline selections
      form.addEventListener('change', (e) => {
        const target = e.target as HTMLInputElement;
        if (target.name === 'interest') {
          trackEvent('Engagement', 'Exit Popup Intent Selected', target.value);
        }
        if (target.name === 'timeline') {
          trackEvent('Engagement', 'Exit Popup Timeline Selected', target.value);
        }
      });

      // Personalize headline based on current page zip
      const zipMatch = window.location.pathname.match(/\/market\/(\d{5})\//);
      if (zipMatch) {
        const titleEl = document.getElementById('exit-popup-title');
        if (titleEl) titleEl.textContent = `Get Your ${zipMatch[1]} Market Update`;
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const formData = new FormData(form);
        // Add a fallback name; do NOT send an empty town — the server derives town
        // from the zipcode. (Sending town='' previously failed validation 100%.)
        if (!formData.get('name')) formData.set('name', 'Website Visitor');
        if (!formData.get('town')) formData.delete('town');

        const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Submitting...';
        }

        try {
          const response = await fetch('/api/market-report', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams(formData as any).toString(),
          });

          if (response.ok) {
            // Show success and suppress for the rest of the session.
            form.style.display = 'none';
            if (successMsg) successMsg.style.display = 'block';
            sessionStorage.setItem(STORAGE_KEY, 'true');

            // Track conversion
            trackEvent('Lead', 'Exit Intent Popup');

            // Auto-close after 3 seconds
            setTimeout(hidePopup, 3000);
          } else {
            throw new Error('Form submission failed');
          }
        } catch (error) {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Get Market Updates';
          }
          alert('There was an error. Please try again.');
        }
      });
    }
  };

  // Fires on initial load and after every view-transition navigation.
  document.addEventListener('astro:page-load', initExitPopup);
</script>

<style>
  .exit-popup-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.7);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: var(--z-modal);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    padding: var(--space-4);
  }

  .exit-popup-overlay.visible {
    opacity: 1;
    visibility: visible;
  }

  .exit-popup {
    background: var(--white);
    border-radius: var(--radius-xl);
    max-width: 420px;
    width: 100%;
    position: relative;
    transform: scale(0.9) translateY(20px);
    transition: transform 0.3s ease;
    box-shadow: var(--shadow-lg);
  }

  .exit-popup-overlay.visible .exit-popup {
    transform: scale(1) translateY(0);
  }

  .popup-close {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--off-white);
    border: none;
    border-radius: var(--radius-full);
    cursor: pointer;
    color: var(--text-secondary);
    transition: all var(--transition-base);
  }

  .popup-close:hover {
    background: var(--light-gray);
    color: var(--text-primary);
  }

  .popup-content {
    padding: var(--space-8);
    text-align: center;
  }

  .popup-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    background: linear-gradient(135deg, var(--c21-gold-light), var(--c21-gold));
    border-radius: var(--radius-full);
    color: var(--white);
    margin-bottom: var(--space-4);
  }

  .popup-content h2 {
    font-size: var(--text-2xl);
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .popup-content > p {
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-6);
  }

  .popup-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .hidden {
    display: none !important;
  }

  .form-row {
    display: flex;
    gap: var(--space-3);
  }

  .form-row input[type="email"] {
    flex: 2;
  }

  .form-row input[type="text"] {
    flex: 1;
    max-width: 100px;
  }

  /* Intent Question */
  .intent-question {
    margin-bottom: var(--space-3);
    text-align: left;
  }

  .question-label {
    display: block;
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .intent-options {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
  }

  .intent-option {
    position: relative;
    cursor: pointer;
  }

  .intent-option input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .intent-option span {
    display: block;
    padding: var(--space-2) var(--space-2);
    border: 2px solid var(--border-color);
    border-radius: var(--radius-md);
    font-size: 0.7rem;
    text-align: center;
    transition: all var(--transition-base);
    line-height: 1.3;
  }

  .intent-option:hover span {
    border-color: var(--c21-gold);
    background: rgba(201, 156, 51, 0.05);
  }

  .intent-option input:checked + span {
    border-color: var(--c21-gold);
    background: rgba(201, 156, 51, 0.1);
    color: var(--c21-gold-dark);
    font-weight: var(--font-medium);
  }

  /* a11y: native radios are visually hidden — surface keyboard focus on the styled
     label surrogates (WCAG 2.4.7). */
  .intent-option input:focus-visible + span,
  .timeline-option input:focus-visible + span {
    outline: 2px solid var(--cta-primary);
    outline-offset: 2px;
  }

  .popup-input {
    padding: var(--space-3) var(--space-4);
    border: 2px solid var(--border-color);
    border-radius: var(--radius-md);
    font-size: var(--text-base);
    width: 100%;
    box-sizing: border-box;
    transition: all var(--transition-base);
  }

  .popup-input:focus {
    outline: none;
    border-color: var(--c21-gold);
    box-shadow: 0 0 0 3px rgba(201, 156, 51, 0.1);
  }

  /* Timeline Question */
  .timeline-question {
    margin-bottom: var(--space-3);
    text-align: left;
  }

  .timeline-label {
    display: block;
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .timeline-options {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2);
  }

  .timeline-option {
    position: relative;
    cursor: pointer;
  }

  .timeline-option input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .timeline-option span {
    display: block;
    padding: var(--space-2) var(--space-3);
    border: 2px solid var(--border-color);
    border-radius: var(--radius-md);
    font-size: var(--text-xs);
    text-align: center;
    transition: all var(--transition-base);
  }

  .timeline-option:hover span {
    border-color: var(--c21-gold);
    background: rgba(201, 156, 51, 0.05);
  }

  .timeline-option input:checked + span {
    border-color: var(--c21-gold);
    background: rgba(201, 156, 51, 0.1);
    color: var(--c21-gold-dark);
    font-weight: var(--font-medium);
  }

  .popup-form input[type="email"],
  .popup-form input[type="text"] {
    padding: var(--space-3) var(--space-4);
    border: 2px solid var(--border-color);
    border-radius: var(--radius-md);
    font-size: var(--text-base);
    transition: all var(--transition-base);
  }

  .popup-form input[type="email"]:focus,
  .popup-form input[type="text"]:focus {
    outline: none;
    border-color: var(--c21-gold);
    box-shadow: 0 0 0 3px rgba(201, 156, 51, 0.1);
  }

  .popup-submit {
    padding: var(--space-4);
    background-color: var(--c21-gold);
    color: var(--white);
    border: none;
    border-radius: var(--radius-md);
    font-weight: var(--font-semibold);
    font-size: var(--text-base);
    cursor: pointer;
    transition: all var(--transition-base);
  }

  .popup-submit:hover {
    background-color: var(--c21-gold-dark);
  }

  .popup-submit:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .privacy-note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    margin-top: var(--space-2);
  }

  /* Success state */
  .popup-success {
    padding: var(--space-4) 0;
  }

  .popup-success .success-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 80px;
    height: 80px;
    background: rgba(76, 175, 80, 0.1);
    border-radius: var(--radius-full);
    color: var(--accent-green);
    margin-bottom: var(--space-4);
  }

  .popup-success h3 {
    font-size: var(--text-xl);
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .popup-success p {
    color: var(--text-secondary);
  }

  @media (max-width: 479px) {
    .form-row {
      flex-direction: column;
    }

    .form-row input[type="text"] {
      max-width: 100%;
    }
  }
</style>
