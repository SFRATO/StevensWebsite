---
/**
 * BaseLayout - Core layout component with SEO optimization
 * Used across all pages for consistent structure and metadata
 */
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import StickyCTA from '@components/StickyCTA.astro';
import ExitIntentPopup from '@components/ExitIntentPopup.astro';
import CookieConsent from '@components/CookieConsent.astro';
import { resolveLocationFromPath } from '@utils/pageLocation';
import {
  generateTitle,
  generateDescription,
  generateCanonicalUrl,
  generateRobotsTag,
  generateGeoTags,
} from '@utils/seo';
import {
  generateRealEstateAgentSchema,
  generateLocalBusinessSchema,
  stringifySchema,
} from '@utils/schema';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
  canonical?: string;
  schema?: any; // Additional schema markup
}

const {
  title,
  description,
  ogImage = '/images/headshot.jpg', // TODO: replace default with a branded 1200x630 og-default.jpg
  noindex = false,
  canonical,
  schema,
} = Astro.props;

// Generate meta values
const fullTitle = generateTitle(title);
const metaDescription = generateDescription(description);
const canonicalUrl = canonical || generateCanonicalUrl(Astro.url.pathname);
const robotsTag = generateRobotsTag(noindex);
const geoTags = generateGeoTags();

// OG Image URL (make absolute)
const ogImageUrl = ogImage.startsWith('http')
  ? ogImage
  : `${Astro.site}${ogImage.replace(/^\//, '')}`;

// Generate global schema markup
const agentSchema = generateRealEstateAgentSchema();
const businessSchema = generateLocalBusinessSchema();

// Geographic context of this page, derived from the pathname at build time.
// Global components (exit popup, activity tracking) have no page props, so the
// resolved town/zip/county is published as meta tags for client scripts to read.
const pageLocation = resolveLocationFromPath(Astro.url.pathname);

// Context-aware StickyCTA props based on current page
const pathname = Astro.url.pathname;
let stickyCTAHref = '/contact/';
let stickyCTAText = 'Free Consultation';
if (pathname.match(/^\/market\/[a-z]+-county\/[a-z0-9-]+\/?$/)) {
  stickyCTAHref = `${pathname.replace(/\/?$/, '')}/#lead-capture`;
  stickyCTAText = 'Get My Free Report';
} else if (pathname.match(/^\/market\/\d{5}\/?$/)) {
  stickyCTAHref = `${pathname.replace(/\/?$/, '')}/#lead-capture`;
  stickyCTAText = 'Get My Free Report';
} else if (pathname.startsWith('/tools/')) {
  stickyCTAHref = '#lead-capture';
  stickyCTAText = 'Get Personalized Analysis';
} else if (pathname.startsWith('/home-value/')) {
  stickyCTAHref = '#lead-capture';
  stickyCTAText = 'Get My Free CMA';
} else if (pathname.startsWith('/market/')) {
  stickyCTAHref = '/contact/';
  stickyCTAText = 'Get Free Home Value';
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#08090B" />

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={metaDescription} />
    <meta name="robots" content={robotsTag} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Geo-Targeting Meta Tags -->
    <meta name="geo.region" content={geoTags['geo.region']} />
    <meta name="geo.placename" content={geoTags['geo.placename']} />
    <meta name="geo.position" content={geoTags['geo.position']} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Steven Frato - Century 21" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon (Placeholder) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* TODO: add a real 180x180 /apple-touch-icon.png, then restore this link.
        It was removed because the file did not exist, 404-ing on every page. */}

    <!-- Structured Data - Real Estate Agent -->
    <script type="application/ld+json" set:html={stringifySchema(agentSchema)} />

    <!-- Structured Data - Local Business -->
    <script type="application/ld+json" set:html={stringifySchema(businessSchema)} />

    <!-- Page-Specific Schema (if provided) -->
    {schema && (
      <script type="application/ld+json" set:html={stringifySchema(schema)} />
    )}

    <!-- View Transitions for smooth page navigation -->
    <ViewTransitions />

    <!-- Preconnect to external domains for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Fonts. Loaded here rather than via an @import in global.css, which
         chained two blocking requests before the first paint. -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap"
      />
    </noscript>

    <!-- Page geography (read by client scripts; no zipcodes.json in the bundle) -->
    {pageLocation?.town && <meta name="sf:town" content={pageLocation.town} />}
    {pageLocation?.zipcode && <meta name="sf:zip" content={pageLocation.zipcode} />}
    {pageLocation?.county && <meta name="sf:county" content={pageLocation.county} />}

    <!--
      Consent gate: Matomo boots cookieless and only sets a visitor cookie once
      the visitor accepts (src/utils/consent.ts pushes rememberCookieConsentGiven).
      `requireCookieConsent` is deliberate — `requireConsent` would suppress
      tracking entirely rather than just the cookie. GA4 is not loaded here at
      all; consent.ts injects it on grant.
    -->
    <script is:inline>
      window._paq = window._paq || [];
      window._paq.push(['requireCookieConsent']);
    </script>

    <!-- Matomo Tag Manager -->
    <script is:inline>
      var _mtm = window._mtm = window._mtm || [];
      _mtm.push({ 'mtm.startTime': new Date().getTime(), 'event': 'mtm.Start' });
      (function () {
        var d = document,
          g = d.createElement('script'),
          s = d.getElementsByTagName('script')[0];
        g.async = true;
        g.src = 'https://analytics.gavinrozzi.com/js/container_YLdIYnl6.js';
        s.parentNode.insertBefore(g, s);
      })();
    </script>
    <!-- End Matomo Tag Manager -->

    <!--
      Google Analytics 4 is intentionally NOT loaded here. GA4 sets third-party
      advertising cookies, so consent.ts injects gtag.js on demand once the
      visitor accepts (and only when PUBLIC_GA4_ID is configured).
    -->

    <!-- Analytics: virtual pageviews + site-wide tel/mailto click tracking -->
    <script>
      import { initPageviewTracking, initLinkTracking, trackEvent } from '@utils/analytics';
      import { initLeadIdentity } from '@utils/leadIdentity';
      import { initLeadActivityTracking } from '@utils/leadActivity';
      import { initScrollNarrative } from '@utils/scrollReveal';
      initPageviewTracking();
      initLinkTracking();
      // Keeps the lead cookie in sync with the consent decision (promote on
      // accept, drop on decline/withdraw).
      initLeadIdentity();
      // Per-lead page views. No-ops for anonymous visitors and for anyone who
      // declined cookies.
      initLeadActivityTracking();

      // Scroll-depth tracking for market and tool pages
      let scrollDepthBound = false;
      const initScrollDepth = () => {
        const isTrackablePage = /\/(market|tools|home-value|moving-to)\//.test(window.location.pathname);
        if (!isTrackablePage || scrollDepthBound) return;
        scrollDepthBound = true;

        const milestones = [50, 100];
        const reached = new Set<number>();

        const checkDepth = () => {
          const scrollPct = Math.round(
            (window.scrollY / (document.documentElement.scrollHeight - window.innerHeight)) * 100
          );
          for (const m of milestones) {
            if (!reached.has(m) && scrollPct >= m) {
              reached.add(m);
              trackEvent('Engagement', 'Scroll Depth', `${m}%`, m);
            }
          }
        };

        window.addEventListener('scroll', checkDepth, { passive: true });
      };

      document.addEventListener('astro:page-load', () => {
        scrollDepthBound = false;
        initScrollDepth();
        // Scroll reveals + the sticky market scrollytelling scene. No-ops on
        // pages without [data-reveal] / [data-scrolly].
        initScrollNarrative();
      });
    </script>
  </head>

  <body>
    <!-- Skip to Content Link (Accessibility) -->
    <a href="#main-content" class="skip-to-content">
      Skip to main content
    </a>

    <!-- Header -->
    <Header />

    <!-- Main Content Slot -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <!-- Sticky CTA Bar -->
    <StickyCTA ctaHref={stickyCTAHref} ctaText={stickyCTAText} />

    <!-- Exit Intent Popup -->
    <ExitIntentPopup />

    <!-- Cookie Consent (gates Matomo cookies + GA4) -->
    <CookieConsent />
  </body>
</html>

<style>
  /* Page-level styles */
  html {
    scroll-behavior: smooth;
  }

  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  main {
    flex: 1;
  }
</style>
