---
/**
 * Contact Page
 * Dedicated contact page with qualification quiz and information
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import QualificationQuiz from '@components/QualificationQuiz.astro';
import { generateBreadcrumbSchema, generateFAQSchema } from '@utils/schema';

const faqs = [
  { question: 'How do I find a good realtor in Burlington County NJ?', answer: 'Look for a licensed NJ realtor who specializes in your specific county and has data-driven knowledge of local market conditions. Steven Frato is a licensed NJ agent (License #2567370) serving Burlington, Mercer, and Middlesex Counties with up-to-date market data for every town and zip code in the area. You can reach him directly at (609) 789-0126.' },
  { question: 'Does Steven Frato work with first-time home buyers?', answer: 'Yes. First-time buyers are a specialty. Steven walks you through pre-approval, offer strategy, inspection, attorney review, and closing — step by step. He can also connect you with trusted local lenders and attorneys who know Burlington, Mercer, and Middlesex County transactions.' },
  { question: 'How much does it cost to hire a real estate agent in NJ?', answer: 'For sellers, the total commission is typically 4–6% of the sale price, split between the listing agent and buyer\'s agent. For buyers, representation is generally free — the seller pays the commission. There\'s no upfront cost to consult with Steven or get a free market report.' },
  { question: 'What areas does Steven Frato serve?', answer: 'Steven serves Burlington County (Moorestown, Mount Laurel, Medford, Evesham, Bordentown, and more), Mercer County (Princeton, West Windsor, Hamilton, Trenton, Lawrenceville, and more), and Middlesex County (South Brunswick, Old Bridge, East Brunswick, Edison, and more). All 3 counties, all 130+ towns.' },
  { question: 'How do I schedule a free real estate consultation?', answer: 'Fill out the form on this page, call (609) 789-0126, or email sf@stevenfrato.com. Steven typically responds within a few hours during business hours. Consultations are free and come with no obligation — you\'ll receive a personalized market report for your area.' },
];

const schema = [
  generateBreadcrumbSchema([
    { name: 'Home', url: 'https://stevenfrato.com/' },
    { name: 'Contact', url: 'https://stevenfrato.com/contact/' },
  ]),
  generateFAQSchema(faqs),
];
---

<BaseLayout
  title="Contact a Realtor in Burlington County NJ"
  description="Looking for a realtor in Burlington, Mercer, or Middlesex County NJ? Contact Steven Frato for a free consultation — buyers and sellers welcome. Call (609) 789-0126."
  schema={schema}
>
  <!-- Page Header -->
  <section class="page-header">
    <div class="container">
      <h1>Contact Your Burlington County Realtor</h1>
      <p class="subtitle">
        Answer a few quick questions and I'll send you a personalized market report
        for your area. No obligation — just helpful insights from a local agent.
      </p>
    </div>
  </section>

  <!-- Contact Section with Quiz and Info -->
  <section class="contact-section">
    <div class="container">
      <div class="contact-grid">
        <!-- Contact Info Sidebar -->
        <div class="contact-info">
          <h2>Get in Touch</h2>
          <p class="info-intro">
            Have questions? I'm here to help with all your real estate needs in
            Burlington, Mercer, and Middlesex Counties.
          </p>

          <div class="contact-items">
            <div class="contact-item">
              <div class="contact-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                  <path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" stroke="currentColor" stroke-width="2"/>
                </svg>
              </div>
              <div>
                <div class="contact-label">Phone</div>
                <a href="tel:+16097890126" class="contact-link">(609) 789-0126</a>
              </div>
            </div>

            <div class="contact-item">
              <div class="contact-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                  <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" stroke="currentColor" stroke-width="2"/>
                </svg>
              </div>
              <div>
                <div class="contact-label">Email</div>
                <a href="mailto:sf@stevenfrato.com" class="contact-link">sf@stevenfrato.com</a>
              </div>
            </div>

            <div class="contact-item">
              <div class="contact-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" stroke="currentColor" stroke-width="2"/>
                </svg>
              </div>
              <div>
                <div class="contact-label">Service Area</div>
                <div class="contact-text">Burlington, Mercer &amp; Middlesex<br>Counties, New Jersey</div>
              </div>
            </div>
          </div>

          <div class="service-areas">
            <h3>Service Areas</h3>
            <ul>
              <li>Burlington County</li>
              <li>Mercer County</li>
              <li>Middlesex County</li>
            </ul>
          </div>
        </div>

        <!-- Qualification Quiz -->
        <div class="quiz-container">
          <QualificationQuiz
            formName="contact-qualification"
            variant="full"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section for SEO -->
  <section class="contact-faq">
    <div class="container">
      <h2>Frequently Asked Questions</h2>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-faq {
    padding: var(--space-12) 0;
    background: var(--surface-2);
  }
  .contact-faq h2 {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    color: var(--text-primary);
    margin-bottom: var(--space-6);
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 800px;
  }
  .faq-item {
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    background: var(--surface-1);
    overflow: hidden;
  }
  .faq-item summary {
    padding: var(--space-4) var(--space-5);
    font-weight: var(--font-semibold);
    cursor: pointer;
    color: var(--text-primary);
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item p {
    padding: 0 var(--space-5) var(--space-4);
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  .page-header {
    padding: var(--space-10) 0 var(--space-6);
    background: linear-gradient(135deg, var(--ink-850) 0%, var(--ink-850) 70%, var(--accent-wash-strong) 100%);
    text-align: center;
  }

  .page-header h1 {
    font-size: var(--text-4xl);
    color: var(--text-primary);
    margin-bottom: var(--space-3);
  }

  .subtitle {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 700px;
    margin: 0 auto;
  }

  /* Contact Section */
  .contact-section {
    padding: var(--space-12) 0;
    background: var(--surface-sunken);
  }

  .contact-grid {
    display: grid;
    gap: var(--space-8);
  }

  @media (min-width: 1024px) {
    .contact-grid {
      grid-template-columns: 1fr 1.5fr;
      gap: var(--space-10);
    }
  }

  /* Contact Info */
  .contact-info {
    background: var(--surface-1);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    height: fit-content;
  }

  .contact-info h2 {
    font-size: var(--text-2xl);
    color: var(--text-primary);
    margin-bottom: var(--space-3);
  }

  .info-intro {
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-6);
  }

  .contact-items {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .contact-item {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .contact-icon {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--accent-wash-strong);
    border-radius: var(--radius-md);
    color: var(--text-primary);
  }

  .contact-label {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    font-weight: var(--font-medium);
    margin-bottom: var(--space-1);
  }

  .contact-link {
    font-size: var(--text-lg);
    color: var(--text-primary);
    font-weight: var(--font-semibold);
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .contact-link:hover {
    color: var(--accent-bright);
  }

  .contact-text {
    font-size: var(--text-base);
    color: var(--text-primary);
    line-height: var(--leading-relaxed);
  }

  /* Service Areas */
  .service-areas {
    padding-top: var(--space-5);
    border-top: 1px solid var(--border-color);
  }

  .service-areas h3 {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: var(--space-3);
  }

  .service-areas ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .service-areas li {
    background: var(--surface-sunken);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--text-primary);
  }

  /* Quiz Container */
  .quiz-container {
    /* Quiz component has its own styling */
  }
</style>
