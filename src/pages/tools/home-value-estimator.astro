---
/**
 * Home Value Estimator Tool — /tools/home-value-estimator/
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import MarketReportForm from '@components/MarketReportForm.astro';
import HomeValueEstimatorIsland from '@components/tools/HomeValueEstimatorIsland';
import { generateBreadcrumbSchema, generateSoftwareApplicationSchema, generateFAQSchema } from '@utils/schema';
import { getTownZipMappings, getAllValidZipcodes } from '../../data/town-mappings';
import zipcodesData from '../../../data/processed/zipcodes.json';
import { withoutDates } from '../../data/dataSource';

const mappings = getTownZipMappings();
const validZipcodes = getAllValidZipcodes();

const faqs = [
  { question: 'How accurate is this home value estimate?', answer: 'This estimate is based on the median sale price in your zip code, adjusted for property type and size. It provides a reasonable ballpark range (±8–15%). For a precise valuation, request a free Comparative Market Analysis from Steven, which accounts for your specific property condition, recent comparable sales, and current buyer demand.' },
  { question: 'What factors affect my home value in NJ?', answer: 'Key factors include location (town, zip code, school district), property size (beds, baths, square footage), condition and recent updates, proximity to amenities, and current market conditions (inventory, buyer demand, interest rates). Burlington, Mercer, and Middlesex counties each have distinct micro-markets.' },
  { question: 'How is this different from Zillow\'s Zestimate?', answer: 'Zillow\'s Zestimate uses national algorithms trained on public records. This tool uses hyperlocal data from actual sales in your specific NJ zip code, weighted for local market conditions like the current seller/buyer dynamic and days-on-market trends.' },
  { question: 'How often is the market data updated?', answer: 'Market data is updated monthly using Redfin\'s public market tracker, which aggregates MLS sale data. The displayed data reflects transactions through the most recent reporting period.' },
  { question: 'How do I find out what my home is worth in NJ?', answer: 'The fastest way to get a ballpark is to use this free estimator — enter your zip code and property details and you\'ll have a range in 30 seconds. For a precise valuation, request a free Comparative Market Analysis (CMA) from a local agent like Steven Frato, who will analyze recent comparable sales within a half-mile of your property, adjusting for condition, upgrades, and current buyer demand. A CMA is more accurate than any online estimate because it accounts for factors algorithms can\'t see.' },
  { question: 'How much has my NJ home value increased?', answer: 'Home values across Burlington, Mercer, and Middlesex counties have appreciated significantly over the past few years. Year-over-year price changes vary by zip code — use this tool to see the specific appreciation rate for your area. If you\'ve owned your home for 3+ years, you likely have more equity than you think.' },
];

const schema = [
  generateBreadcrumbSchema([
    { name: 'Home', url: 'https://stevenfrato.com/' },
    { name: 'Free Tools', url: 'https://stevenfrato.com/tools/' },
    { name: 'Home Value Estimator', url: 'https://stevenfrato.com/tools/home-value-estimator/' },
  ]),
  generateSoftwareApplicationSchema({
    name: 'What Is My NJ Home Worth? Free Home Value Estimator',
    description: 'Instant home value estimate for Burlington, Mercer, and Middlesex County NJ homes based on recent local sales data. Find out what your house is worth in 30 seconds.',
    url: 'https://stevenfrato.com/tools/home-value-estimator/',
  }),
  generateFAQSchema(faqs),
];
---

<BaseLayout
  title="What Is My NJ Home Worth? Free Home Value Estimator"
  description="Find out what your NJ home is worth instantly. Free home value estimator for Burlington, Mercer, and Middlesex County — based on real local sales data, no registration needed."
  schema={schema}
>
  <section class="tool-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>›</span>
        <a href="/tools/">Tools</a>
        <span>›</span>
        <span aria-current="page">Home Value Estimator</span>
      </nav>
      <h1>What Is My NJ Home Worth?</h1>
      <p class="hero-sub">Get an instant estimate based on recent sales in your neighborhood. Takes 30 seconds — no registration needed.</p>
    </div>
  </section>

  <section class="tool-section">
    <div class="container tool-layout">
      <div class="tool-main">
        <HomeValueEstimatorIsland
          client:load
          mappings={mappings}
          zipcodes={withoutDates(zipcodesData as any) as any}
        />
      </div>
      <aside class="tool-sidebar">
        <div class="sidebar-card">
          <h3>How It Works</h3>
          <ol class="steps">
            <li>Select your town or zip code</li>
            <li>Enter basic property details</li>
            <li>Get an instant estimated range</li>
          </ol>
          <p class="sidebar-note">For a precise market analysis with comparable sales, request a free CMA from Steven below.</p>
        </div>
        <div class="sidebar-card trust">
          <div class="trust-icon">🔒</div>
          <p>No signup required. Your information is never shared or sold.</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="form-section" id="lead-capture">
    <div class="container">
      <div class="form-intro">
        <h2>Get a Precise Analysis — Free</h2>
        <p>The estimator gives you a range. A Comparative Market Analysis from Steven gives you the exact number, with comparable sales and a recommended list price.</p>
      </div>
      <MarketReportForm
        location="NJ"
        townName="Your Town"
        formName="market-report"
      />
    </div>
  </section>

  <section class="faq-section">
    <div class="container">
      <h2>Frequently Asked Questions</h2>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    document.addEventListener('tool:lead-ready', ((e: CustomEvent) => {
      const form = document.getElementById('lead-capture');
      if (form) {
        form.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }) as EventListener);
  });
</script>

<style>
  .tool-hero {
    background: linear-gradient(135deg, var(--ink-850) 0%, var(--ink-800) 100%);
    padding: var(--space-12) 0 var(--space-10);
    color: var(--text-primary);
  }

  .breadcrumb {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: var(--space-4);
  }

  .breadcrumb a { color: var(--text-muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--text-primary); }

  h1 {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    margin: 0 0 var(--space-3);
    color: var(--text-primary);
  }

  .hero-sub { font-size: var(--text-lg); color: var(--text-muted); margin: 0; }

  .tool-section { padding: var(--space-10) 0; background: var(--surface-2); }

  .tool-layout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: var(--space-8);
    align-items: start;
  }

  @media (max-width: 768px) {
    .tool-layout { grid-template-columns: 1fr; }
    .tool-sidebar { order: -1; }
  }

  .sidebar-card {
    background: var(--surface-1);
    border: 1px solid var(--rule);
    border-radius: 0.75rem;
    padding: var(--space-5);
    margin-bottom: var(--space-4);
  }

  .sidebar-card h3 {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 var(--space-3);
  }

  .steps {
    padding-left: 1.25rem;
    margin: 0 0 var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .sidebar-note { font-size: 0.8rem; color: var(--text-secondary); margin: 0; }

  .sidebar-card.trust { display: flex; align-items: flex-start; gap: var(--space-3); }
  .trust-icon { font-size: 1.5rem; flex-shrink: 0; }
  .sidebar-card.trust p { font-size: 0.8rem; color: var(--text-secondary); margin: 0; }

  .form-section { padding: var(--space-12) 0; }

  .form-intro {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-8);
  }

  .form-intro h2 {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    color: var(--text-primary);
    margin: 0 0 var(--space-3);
  }

  .form-intro p { color: var(--text-secondary); margin: 0; }

  .faq-section { padding: var(--space-12) 0; background: var(--surface-2); border-top: 1px solid var(--rule); }

  .faq-section h2 {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    margin: 0 0 var(--space-6);
    color: var(--text-primary);
    text-align: center;
  }

  .faq-list { max-width: 720px; margin: 0 auto; display: flex; flex-direction: column; gap: var(--space-3); }

  .faq-item {
    background: var(--surface-1);
    border: 1px solid var(--rule);
    border-radius: 0.75rem;
    overflow: hidden;
  }

  .faq-item summary {
    padding: var(--space-4) var(--space-5);
    font-weight: 600;
    cursor: pointer;
    color: var(--text-primary);
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .faq-item summary::after { content: '+'; font-size: 1.25rem; color: var(--accent-bright); }
  .faq-item[open] summary::after { content: '−'; }

  .faq-item p {
    padding: 0 var(--space-5) var(--space-4);
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.7;
    font-size: var(--text-sm);
  }
</style>
