---
/**
 * Tools Hub — /tools/
 * Directory of all free NJ real estate tools.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import { generateBreadcrumbSchema, generateFAQSchema } from '@utils/schema';
import countiesData from '../../../data/processed/counties.json';
import { formatCurrency } from '@utils/market-analysis';

interface CountyData {
  region: string;
  slug: string;
  median_sale_price: number | null;
  market_type: 'seller' | 'buyer' | 'balanced';
}

const counties = countiesData as CountyData[];

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Home', url: 'https://stevenfrato.com/' },
  { name: 'Free Tools', url: 'https://stevenfrato.com/tools/' },
]);

const toolsFaqs = [
  { question: 'How do I find out what my NJ home is worth for free?', answer: 'Use the free Home Value Estimator at stevenfrato.com/tools/home-value-estimator/. Enter your zip code and property details and get an instant estimate based on recent local sales data — no registration required. For a more precise valuation, request a free Comparative Market Analysis (CMA) from Steven Frato.' },
  { question: 'How do I calculate NJ transfer tax and closing costs as a seller?', answer: 'Use the free NJ Transfer Tax & Net Proceeds Calculator at stevenfrato.com/tools/proceeds-calculator/. Enter your expected sale price and it calculates the NJ Realty Transfer Fee (RTF), exit tax (GIT withholding), agent commission, and all closing costs — showing your estimated net proceeds instantly.' },
  { question: 'How much house can I afford to buy in NJ?', answer: 'Use the free NJ Mortgage Affordability Calculator at stevenfrato.com/tools/affordability-calculator/. Enter your gross income, down payment amount, and zip code. It factors in NJ\'s high property taxes (which significantly affect affordability) and shows your maximum home price, monthly payment breakdown, and how you compare to local market prices.' },
  { question: 'How do I know if it\'s a good time to sell my house in NJ?', answer: 'Use the free Market Timing Tool at stevenfrato.com/tools/should-i-sell-now/. Select your zip code and it analyzes 5 market factors — current market type, year-over-year price trend, days on market, percentage of homes selling above asking price, and inventory levels — and returns a data-backed sell/wait verdict.' },
  { question: 'Are these NJ real estate tools really free?', answer: 'Yes, all four tools are completely free to use with no registration, no sign-up, and no credit card required. They are provided by Steven Frato, a licensed NJ realtor (License #2567370), as a resource for buyers and sellers in Burlington, Mercer, and Middlesex Counties.' },
];

const faqSchema = generateFAQSchema(toolsFaqs);

const tools = [
  {
    href: '/tools/home-value-estimator/',
    icon: '🏠',
    name: 'Home Value Estimator',
    description: 'Get an instant estimate of your NJ home\'s value based on recent local sales data. Takes 30 seconds.',
    bestFor: 'Homeowners considering selling',
    stat: counties[0]?.median_sale_price ? `Burlington Co. median: ${formatCurrency(counties[0].median_sale_price)}` : 'Updated monthly',
    cta: 'Estimate My Home\'s Value',
  },
  {
    href: '/tools/should-i-sell-now/',
    icon: '📊',
    name: 'Market Timing Tool',
    description: 'See a data-backed verdict on whether now is the right time to sell in your specific area.',
    bestFor: 'Sellers weighing their options',
    stat: `${counties.filter(c => c.market_type === 'seller').length} of 3 counties are seller\'s markets`,
    cta: 'Check My Market',
  },
  {
    href: '/tools/proceeds-calculator/',
    icon: '💰',
    name: 'Net Proceeds Calculator',
    description: 'Calculate exactly how much you\'ll walk away with after agent commission, NJ exit tax, and all closing costs.',
    bestFor: 'Sellers ready to crunch numbers',
    stat: 'Includes NJ Realty Transfer Fee & GIT',
    cta: 'Calculate My Proceeds',
  },
  {
    href: '/tools/affordability-calculator/',
    icon: '🔑',
    name: 'Affordability Calculator',
    description: 'Find out how much home you can realistically afford in Burlington, Mercer, or Middlesex County.',
    bestFor: 'First-time buyers and move-up buyers',
    stat: 'Based on 36% DTI & NJ property taxes',
    cta: 'See My Budget',
  },
];
---

<BaseLayout
  title="Free NJ Real Estate Calculators — Home Value, Transfer Tax, Mortgage & Market Timing"
  description="Free NJ real estate calculators: home value estimator, NJ transfer tax & net proceeds calculator, mortgage affordability calculator, and market timing tool. No signup, instant results."
  schema={[breadcrumbSchema, faqSchema]}
>
  <section class="tools-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">Free Tools</span>
      </nav>
      <h1>Free NJ Real Estate Tools</h1>
      <p class="hero-sub">Make confident decisions with data from your local market. No registration required.</p>
    </div>
  </section>

  <section class="tools-grid-section">
    <div class="container">
      <div class="tools-grid">
        {tools.map((tool) => (
          <a href={tool.href} class="tool-card">
            <div class="tool-icon">{tool.icon}</div>
            <h2 class="tool-name">{tool.name}</h2>
            <p class="tool-desc">{tool.description}</p>
            <div class="tool-meta">
              <span class="best-for">Best for: {tool.bestFor}</span>
              <span class="tool-stat">{tool.stat}</span>
            </div>
            <div class="tool-cta">{tool.cta} →</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="tools-trust">
    <div class="container">
      <p class="trust-text">
        These tools use real sales data from recent transactions across <strong>97 zip codes</strong> in Burlington, Mercer, and Middlesex Counties. Data updated monthly from Redfin's public market tracker.
      </p>
      <p class="trust-cta">
        Need a personalized analysis? <a href="/contact/">Talk to Steven directly</a> — no obligation, no pressure.
      </p>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="tools-faq">
    <div class="container">
      <h2>NJ Real Estate Tools — Common Questions</h2>
      <div class="faq-list">
        {toolsFaqs.map((faq) => (
          <details class="faq-item">
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .tools-faq {
    padding: var(--space-12) 0;
    background: var(--surface-2);
  }
  .tools-faq h2 {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    color: var(--text-primary);
    margin-bottom: var(--space-6);
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 800px;
  }
  .faq-item {
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    background: var(--surface-1);
    overflow: hidden;
  }
  .faq-item summary {
    padding: var(--space-4) var(--space-5);
    font-weight: var(--font-semibold);
    cursor: pointer;
    color: var(--text-primary);
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item p {
    padding: 0 var(--space-5) var(--space-4);
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  .tools-hero {
    background: linear-gradient(135deg, var(--ink-850) 0%, var(--ink-800) 100%);
    padding: var(--space-12) 0 var(--space-10);
    color: var(--text-primary);
  }

  .breadcrumb {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: var(--space-4);
  }

  .breadcrumb a { color: var(--text-muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--text-primary); }

  h1 {
    font-family: var(--font-heading);
    font-size: var(--text-4xl);
    margin: 0 0 var(--space-3);
    color: var(--text-primary);
  }

  .hero-sub {
    font-size: var(--text-lg);
    color: var(--text-muted);
    margin: 0;
  }

  .tools-grid-section {
    padding: var(--space-12) 0;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  @media (max-width: 640px) {
    .tools-grid { grid-template-columns: 1fr; }
    h1 { font-size: var(--text-2xl); }
  }

  .tool-card {
    display: flex;
    flex-direction: column;
    background: var(--surface-1);
    border: 2px solid var(--rule);
    border-radius: 1rem;
    padding: var(--space-6);
    text-decoration: none;
    color: inherit;
    transition: all 0.2s;
    gap: var(--space-3);
  }

  .tool-card:hover {
    border-color: var(--accent);
    box-shadow: 0 8px 32px rgba(61, 139, 255, 0.18);
    transform: translateY(-2px);
  }

  .tool-icon { font-size: 2.5rem; }

  .tool-name {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    margin: 0;
    color: var(--text-primary);
  }

  .tool-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.6;
    flex: 1;
  }

  .tool-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .best-for {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .tool-stat {
    font-size: 0.75rem;
    color: var(--text-primary);
    font-weight: 500;
  }

  .tool-cta {
    font-weight: 700;
    color: var(--accent-bright);
    font-size: var(--text-sm);
    margin-top: var(--space-2);
  }

  .tools-trust {
    background: var(--surface-2);
    padding: var(--space-8) 0;
    border-top: 1px solid var(--rule);
    text-align: center;
  }

  .trust-text {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto var(--space-3);
  }

  .trust-cta {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin: 0;
  }

  .trust-cta a {
    color: var(--accent-bright);
    font-weight: 600;
    text-decoration: none;
  }
</style>
