---
/**
 * Affordability Calculator — /tools/affordability-calculator/
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import AffordabilityCalculatorIsland from '@components/tools/AffordabilityCalculatorIsland';
import { generateBreadcrumbSchema, generateSoftwareApplicationSchema, generateFAQSchema } from '@utils/schema';
import { getTownZipMappings, getAllValidZipcodes } from '../../data/town-mappings';
import zipcodesData from '../../../data/processed/zipcodes.json';

const mappings = getTownZipMappings();

const faqs = [
  { question: 'How much house can I afford in NJ?', answer: 'A general rule: your total monthly housing payment (principal, interest, taxes, insurance) should not exceed 28% of gross monthly income, and total monthly debts should not exceed 36%. With NJ\'s high property taxes (1.5–2.5% of home value annually), this significantly affects purchasing power. Use this calculator to see your specific numbers.' },
  { question: 'What is the minimum down payment to buy a home in NJ?', answer: 'Conventional loans typically require 5–20% down. FHA loans allow 3.5% down with a 580+ credit score. First-time buyers in NJ may qualify for NJHMFA assistance programs. A 20% down payment eliminates PMI (private mortgage insurance) and reduces monthly costs significantly.' },
  { question: 'What are property taxes like in Burlington, Mercer, and Middlesex Counties?', answer: 'NJ has among the highest property taxes in the nation. Effective rates in these counties typically range from 1.5% to 2.5% of assessed value annually. On a $500,000 home, you might pay $7,500–$12,500/year in property taxes, which adds $625–$1,040/month to your housing costs — a significant factor in affordability calculations.' },
  { question: 'Should I get pre-approved before starting my home search?', answer: 'Yes. Pre-approval shows sellers you\'re serious and clarifies your actual budget. In competitive NJ markets, many sellers won\'t consider offers without pre-approval. Steven can connect you with trusted local lenders who know Burlington, Mercer, and Middlesex County transactions.' },
  { question: 'What salary do I need to buy a house in NJ?', answer: 'Using the standard 28% rule, you need a gross annual income of roughly 4x your annual housing costs. For a $400,000 home in NJ with 10% down, a 7% mortgage, and $9,000/year in property taxes, your total monthly payment is approximately $3,000–$3,400 — meaning you need an income of at least $130,000–$145,000/year to qualify comfortably. NJ\'s high property taxes make income requirements significantly higher than national averages. Use this calculator to see your exact numbers.' },
  { question: 'What credit score do I need to buy a house in NJ?', answer: 'Most conventional lenders require a minimum 620 credit score, but 740+ gets you the best interest rates and lowest PMI premiums. FHA loans allow scores as low as 580 with 3.5% down. A higher credit score can save you tens of thousands of dollars over the life of your mortgage — improving your score before applying is often worth the wait.' },
];

const schema = [
  generateBreadcrumbSchema([
    { name: 'Home', url: 'https://stevenfrato.com/' },
    { name: 'Free Tools', url: 'https://stevenfrato.com/tools/' },
    { name: 'Affordability Calculator', url: 'https://stevenfrato.com/tools/affordability-calculator/' },
  ]),
  generateSoftwareApplicationSchema({
    name: 'NJ Mortgage Affordability Calculator',
    description: 'Free NJ mortgage affordability calculator. See how much house you can afford based on income, down payment, NJ property taxes, and current local market prices.',
    url: 'https://stevenfrato.com/tools/affordability-calculator/',
  }),
  generateFAQSchema(faqs),
];
---

<BaseLayout
  title="NJ Mortgage Affordability Calculator — How Much House Can I Afford?"
  description="Free NJ mortgage affordability calculator. Enter your income, down payment, and zip code to instantly see how much house you can afford in Burlington, Mercer, or Middlesex County."
  schema={schema}
>
  <section class="tool-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>›</span>
        <a href="/tools/">Tools</a>
        <span>›</span>
        <span aria-current="page">Affordability Calculator</span>
      </nav>
      <h1>Can I Afford a Home in NJ?</h1>
      <p class="hero-sub">Enter your income and down payment to see your maximum home price — compared to real local market data from Burlington, Mercer, and Middlesex Counties.</p>
    </div>
  </section>

  <section class="tool-section">
    <div class="container">
      <AffordabilityCalculatorIsland
        client:load
        mappings={mappings}
        zipcodes={zipcodesData as any}
      />
    </div>
  </section>

  <section class="form-section" id="lead-capture">
    <div class="container">
      <div class="form-intro">
        <h2>Ready to Start Your Home Search?</h2>
        <p>Tell Steven what you're looking for. He'll help you navigate the market, connect you with lenders, and find homes that match your budget and lifestyle.</p>
      </div>
      <div class="contact-cta">
        <a href="/contact/" class="btn-primary">Talk to Steven About Buying</a>
        <a href="tel:+16097890126" class="btn-secondary">Call (609) 789-0126</a>
      </div>
    </div>
  </section>

  <section class="faq-section">
    <div class="container">
      <h2>NJ Home Buying — What You Need to Know</h2>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    document.addEventListener('tool:lead-ready', (() => {
      const form = document.getElementById('lead-capture');
      if (form) form.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }) as EventListener);
  });
</script>

<style>
  .tool-hero {
    background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
    padding: var(--space-12) 0 var(--space-10);
    color: #fff;
  }

  .breadcrumb {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.875rem;
    color: #aaa;
    margin-bottom: var(--space-4);
  }

  .breadcrumb a { color: #aaa; text-decoration: none; }
  .breadcrumb a:hover { color: #fff; }

  h1 {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    margin: 0 0 var(--space-3);
    color: #fff;
  }

  .hero-sub { font-size: var(--text-lg); color: #ccc; margin: 0; max-width: 640px; }

  .tool-section { padding: var(--space-10) 0; background: #f8fafc; }
  .tool-section .container { max-width: 760px; }

  .form-section { padding: var(--space-12) 0; text-align: center; }

  .form-intro {
    max-width: 560px;
    margin: 0 auto var(--space-8);
  }

  .form-intro h2 {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    color: var(--charcoal);
    margin: 0 0 var(--space-3);
  }

  .form-intro p { color: var(--text-secondary); margin: 0; }

  .contact-cta {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-block;
    padding: 1rem 2rem;
    background: var(--c21-gold);
    color: #fff;
    border-radius: 0.5rem;
    font-weight: 700;
    text-decoration: none;
    font-size: 1rem;
  }

  .btn-secondary {
    display: inline-block;
    padding: 1rem 2rem;
    border: 2px solid var(--charcoal);
    color: var(--charcoal);
    border-radius: 0.5rem;
    font-weight: 700;
    text-decoration: none;
    font-size: 1rem;
  }

  .faq-section { padding: var(--space-12) 0; background: #f8fafc; border-top: 1px solid #e2e8f0; }

  .faq-section h2 {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    margin: 0 0 var(--space-6);
    color: var(--charcoal);
    text-align: center;
  }

  .faq-list { max-width: 720px; margin: 0 auto; display: flex; flex-direction: column; gap: var(--space-3); }

  .faq-item {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 0.75rem;
    overflow: hidden;
  }

  .faq-item summary {
    padding: var(--space-4) var(--space-5);
    font-weight: 600;
    cursor: pointer;
    color: var(--charcoal);
    list-style: none;
  }

  .faq-item summary::after { content: ' +'; color: var(--c21-gold); }
  .faq-item[open] summary::after { content: ' −'; }

  .faq-item p {
    padding: 0 var(--space-5) var(--space-4);
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.7;
    font-size: var(--text-sm);
  }
</style>
