---
/**
 * PA vs NJ overview / out-of-area (Bucks County, PA) capture page.
 *
 * Honest scaffolding: the site currently serves Burlington, Mercer, and Middlesex
 * Counties in NJ. This page answers the cross-border buyer's question, provides
 * general PA-vs-NJ education (NOT legal/tax advice), and captures out-of-area leads.
 *
 * NOTE (compliance): before MARKETING PA services or publishing PA market data,
 * add PA real estate license/brokerage identification and PA-compliant disclosures,
 * and confirm Steven's PA licensure or a co-broker/referral arrangement.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import OutOfAreaForm from '@components/OutOfAreaForm.astro';

const title = 'Buying in PA vs. NJ — Bucks County & the Delaware Valley | Steven Frato';
const description =
  'Comparing Bucks County, PA (Newtown, Doylestown, Levittown) with nearby New Jersey? A plain-English look at the differences in property taxes, transfer taxes, and the closing process — and how to get help on either side of the river.';

const differences = [
  {
    h: 'Property taxes',
    nj: 'New Jersey has among the highest average property tax bills in the country, though it varies widely by town.',
    pa: 'Pennsylvania property taxes are generally lower on average, but also vary by school district and municipality.',
  },
  {
    h: 'Transfer taxes at closing',
    nj: 'NJ charges a Realty Transfer Fee, customarily paid by the seller, that scales with sale price.',
    pa: 'PA charges a Realty Transfer Tax (a state portion plus a local/school portion) that is commonly split between buyer and seller.',
  },
  {
    h: 'How closings are handled',
    nj: 'NJ contracts typically include a short attorney-review period, and attorneys are commonly involved in the transaction.',
    pa: 'PA transactions are frequently handled through title companies, with attorney involvement varying by buyer preference.',
  },
  {
    h: 'Commute & location',
    nj: 'Burlington/Mercer/Middlesex offer NJ Transit and quick access to both Philadelphia and (further north) New York.',
    pa: 'Bucks County offers SEPTA regional rail toward Philadelphia and Delaware River bridge crossings into NJ.',
  },
];
---

<BaseLayout title={title} description={description}>
  <section class="pa-hero">
    <div class="container">
      <h1>Buying in Pennsylvania vs. New Jersey</h1>
      <p class="pa-hero-sub">
        Weighing Bucks County, PA — Newtown, Doylestown, Levittown — against nearby New Jersey?
        Here's a plain-English comparison, and how to get help on either side of the river.
      </p>
    </div>
  </section>

  <section class="pa-coverage container">
    <div class="pa-note">
      <strong>Where I work:</strong> I'm a licensed New Jersey agent focused on Burlington,
      Mercer, and Middlesex Counties. If you're buying in Bucks County, PA, I'm glad to help
      you compare the two markets and connect you with a trusted Pennsylvania partner — just
      tell me what you're looking for below.
    </div>
  </section>

  <section class="pa-compare container">
    <h2>PA vs. NJ at a glance</h2>
    <div class="compare-grid">
      {differences.map((d) => (
        <div class="compare-row">
          <h3>{d.h}</h3>
          <div class="compare-cols">
            <div><span class="state-tag nj">New Jersey</span><p>{d.nj}</p></div>
            <div><span class="state-tag pa">Pennsylvania</span><p>{d.pa}</p></div>
          </div>
        </div>
      ))}
    </div>
    <p class="pa-disclaimer">
      General information only — not legal or tax advice. Tax rates and closing customs change
      and vary by municipality; confirm current figures with a licensed attorney, title company,
      or tax professional in the relevant state.
    </p>
  </section>

  <section class="pa-form-section container">
    <h2>Looking across the river?</h2>
    <OutOfAreaForm sourceLocation="pa-vs-nj" />
  </section>
</BaseLayout>

<style>
  .pa-hero {
    background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
    color: #fff;
    padding: var(--space-12) 0 var(--space-10);
    text-align: center;
  }
  .pa-hero h1 { font-size: var(--text-4xl); margin-bottom: var(--space-3); }
  .pa-hero-sub { max-width: 720px; margin: 0 auto; color: rgba(255,255,255,0.85); line-height: var(--leading-relaxed); }
  .pa-coverage { padding: var(--space-8) var(--space-4) 0; }
  .pa-note {
    max-width: 820px; margin: 0 auto;
    background: var(--bg-secondary);
    border-left: 4px solid var(--cta-primary);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    color: var(--text-primary);
    line-height: var(--leading-relaxed);
  }
  .pa-compare { padding: var(--space-10) var(--space-4); max-width: 1000px; }
  .pa-compare h2, .pa-form-section h2 { font-size: var(--text-2xl); text-align: center; color: var(--text-primary); margin-bottom: var(--space-8); }
  .compare-grid { display: flex; flex-direction: column; gap: var(--space-5); }
  .compare-row { border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: var(--space-5); }
  .compare-row h3 { font-size: var(--text-lg); color: var(--text-primary); margin-bottom: var(--space-3); }
  .compare-cols { display: grid; grid-template-columns: 1fr; gap: var(--space-4); }
  @media (min-width: 700px) { .compare-cols { grid-template-columns: 1fr 1fr; } }
  .state-tag { display: inline-block; font-size: var(--text-xs); font-weight: var(--font-bold); text-transform: uppercase; letter-spacing: 0.04em; padding: 2px 8px; border-radius: var(--radius-sm); margin-bottom: var(--space-2); }
  .state-tag.nj { background: rgba(201,156,51,0.15); color: var(--cta-primary); }
  .state-tag.pa { background: rgba(25,118,210,0.12); color: var(--info-blue); }
  .compare-cols p { color: var(--text-secondary); line-height: var(--leading-relaxed); margin: 0; }
  .pa-disclaimer { font-size: var(--text-sm); color: var(--text-secondary); text-align: center; margin-top: var(--space-6); max-width: 760px; margin-left: auto; margin-right: auto; }
  .pa-form-section { padding: var(--space-4) var(--space-4) var(--space-12); }
</style>
