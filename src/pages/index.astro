---
/**
 * Homepage — Steven Frato, Burlington County real estate.
 *
 * Structured as a scrollytelling narrative in six acts. Act III is a genuine
 * pinned scrolly scene: a sticky county figure panel that swaps as the reader
 * scrolls the narrative column beside it (see src/utils/scrollReveal.ts). Every
 * county stays in the DOM regardless of which panel is lit, so the page is
 * fully crawlable and works with JS disabled.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import ContactForm from '@components/ContactForm.astro';
import { generateWebsiteSchema } from '@utils/schema';

// Import market data
import countiesData from '../../data/processed/counties.json';
import zipcodesData from '../../data/processed/zipcodes.json';

interface CountyData {
  region: string;
  slug: string;
  state_code: string;
  period_end: string;
  median_sale_price: number | null;
  median_sale_price_yoy: number | null;
  inventory: number | null;
  inventory_yoy: number | null;
  months_of_supply: number | null;
  median_dom: number | null;
  market_type: 'seller' | 'buyer' | 'balanced';
  ai_insight?: string;
}

const counties = countiesData as CountyData[];
const totalZipcodes = zipcodesData.length;

// Calculate total homes tracked (sum of inventory across all zipcodes)
const totalHomesTracked = zipcodesData.reduce((sum: number, zip: any) => sum + (zip.inventory || 0), 0);

// Get last updated date
const lastUpdatedDate = counties[0]?.period_end
  ? new Date(counties[0].period_end).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
  : 'Recently';

// Format currency
const formatCurrency = (value: number | null): string => {
  if (value === null) return 'N/A';
  return new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD',
    maximumFractionDigits: 0,
  }).format(value);
};

const marketLabel = (type: CountyData['market_type']): string =>
  type === 'seller' ? "Seller's Market" : type === 'buyer' ? "Buyer's Market" : 'Balanced Market';

// One narrative line per county for the scrolly column — reads as prose, but
// every figure is drawn from the same build-time data as the panel.
const countyNarrative = (c: CountyData): string => {
  const supply = c.months_of_supply;
  if (c.market_type === 'seller') {
    return `Roughly ${supply !== null ? supply.toFixed(1) : 'under four'} months of supply. Homes are moving in about ${c.median_dom ?? 'under 45'} days, which means well-prepared sellers set the terms — and buyers need to be ready to move before they fall in love with a listing.`;
  }
  if (c.market_type === 'buyer') {
    return `Around ${supply !== null ? supply.toFixed(1) : 'over six'} months of supply. Inventory is sitting long enough that buyers have room to negotiate on price, on repairs, and on closing help. This is where patience pays.`;
  }
  return `About ${supply !== null ? supply.toFixed(1) : 'four to six'} months of supply — neither side holds all the leverage. Pricing accuracy matters more here than in any other market, on both sides of the table.`;
};

const tools = [
  { href: '/tools/home-value-estimator/', label: 'Home Value Estimator', copy: 'An instant estimate from recent local sales. Thirty seconds.' },
  { href: '/tools/should-i-sell-now/', label: 'Market Timing Tool', copy: 'A data-backed verdict on whether now is the right time to sell.' },
  { href: '/tools/proceeds-calculator/', label: 'Proceeds Calculator', copy: 'Your estimated take-home after NJ closing costs.' },
  { href: '/tools/affordability-calculator/', label: 'Affordability Calculator', copy: 'How much home you can actually afford in central NJ.' },
];
---

<BaseLayout
  title="NJ Realtor | Steven Frato — Burlington County Real Estate"
  description="Steven Frato, licensed NJ realtor (License #2567370). I help buyers and sellers in Burlington County get into a home for the lowest price and start building equity. Call (609) 789-0126."
  ogImage="/images/headshot.jpg"
  schema={generateWebsiteSchema()}
>
  <!--
    ACT 0 — Hero.
    Keeps the .market-hero class: analytics.ts linkLocation() classifies every
    tel:/mailto: click by `.hero, .market-hero`, so renaming it would silently
    relabel each hero call event.
  -->
  <section class="hero market-hero">
    <div class="container hero-inner">
      <p class="eyebrow hero-eyebrow">Real Estate &middot; Burlington County, New Jersey</p>

      <h1 class="hero-name">Steven Frato</h1>

      <figure class="hero-quote">
        <blockquote>
          <p>&ldquo;Get in a house and start building your equity.&rdquo;</p>
        </blockquote>
      </figure>

      <p class="hero-sub">
        I work with buyers and sellers across Burlington County — getting people into a home
        for the lowest price the market will allow, so the equity starts working for them
        from the first mortgage payment.
      </p>

      <div class="hero-cta">
        <a href="tel:+16097890126" class="btn btn-primary btn-large hero-call">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          Call (609) 789-0126
        </a>
        <a href="#contact" class="btn btn-secondary btn-large">Send a Message</a>
      </div>

      <a href="#proof" class="scroll-cue" aria-label="Scroll to continue">
        <span class="scroll-cue-line" aria-hidden="true"></span>
        <span class="scroll-cue-text">Scroll</span>
      </a>
    </div>
  </section>

  <!-- ACT I — Proof. Engraved figures on hairline rules. -->
  <section class="act proof" id="proof">
    <div class="container">
      <div class="proof-grid" data-reveal>
        <div class="proof-item">
          <span class="proof-number">{totalZipcodes}+</span>
          <span class="proof-label">Zip Codes Tracked</span>
        </div>
        <div class="proof-item">
          <span class="proof-number">{totalHomesTracked.toLocaleString()}+</span>
          <span class="proof-label">Active Listings Monitored</span>
        </div>
        <div class="proof-item">
          <span class="proof-number">{counties.length}</span>
          <span class="proof-label">Counties Covered</span>
        </div>
        <div class="proof-item">
          <span class="proof-number proof-number-sm">{lastUpdatedDate}</span>
          <span class="proof-label">Data Last Updated</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ACT II — About. -->
  <section class="act about" id="about">
    <div class="container">
      <div class="about-grid">
        <div class="about-portrait" data-reveal>
          <img
            src="/images/headshot.jpg"
            alt="Steven Frato, New Jersey licensed real estate salesperson"
            width="480"
            height="600"
            loading="lazy"
          />
        </div>

        <div class="about-copy" data-reveal>
          <p class="eyebrow">About</p>
          <h2>A freelance agent, working one client at a time.</h2>
          <p>
            I'm Steven Frato, a licensed New Jersey real estate salesperson serving Burlington County.
            I work independently, which means the person who answers your call is the person who
            reads the comps, walks the house, and sits at the negotiating table.
          </p>
          <p>
            My job on the buy side is simple: get you into the right house for the least money the
            market will let me get it for. Every dollar I keep off the purchase price is a dollar of
            equity you own on day one. On the sell side it runs the other way — price it correctly,
            prepare it properly, and get you the most the market will pay.
          </p>

          <ul class="about-list">
            <li>
              <span class="about-list-title">Buyers</span>
              Pre-approval guidance, neighborhood and school-district context, and negotiation
              that treats the list price as an opening position, not a verdict.
            </li>
            <li>
              <span class="about-list-title">Sellers</span>
              A pricing strategy built on current local sales data, preparation that pays for
              itself, and a clear read on what your net actually looks like at closing.
            </li>
            <li>
              <span class="about-list-title">First-time buyers</span>
              A step-by-step walkthrough of the whole process, in plain language, with no
              assumption that you already know how any of it works.
            </li>
          </ul>

          <div class="about-ctas">
            <a href="/about/" class="btn btn-secondary">More About Steven</a>
            <a href="/tools/affordability-calculator/" class="btn btn-secondary">How Much Can I Afford?</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!--
    ACT III — The market, as a pinned scrolly scene.
    The sticky panel swaps county as each narrative step crosses the middle of
    the viewport. All counties render regardless of the active panel.
  -->
  <section class="act market-act" id="market" data-scrolly>
    <div class="container">
      <header class="act-head" data-reveal>
        <p class="eyebrow">The Market</p>
        <h2>What the numbers actually say</h2>
        <p class="act-lede">
          Updated monthly from public sales records across {totalZipcodes} zip codes.
          Not a headline about &ldquo;the housing market&rdquo; — the market you're actually buying in.
        </p>
      </header>

      <div class="scrolly">
        <div class="scrolly-figure">
          <div class="figure-frame">
            {counties.map((county, i) => (
              <article
                class:list={['panel', { 'is-active': i === 0 }]}
                data-panel={county.slug}
              >
                <p class="panel-eyebrow">{county.region}</p>
                <p class={`panel-verdict verdict-${county.market_type}`}>{marketLabel(county.market_type)}</p>

                <dl class="panel-stats">
                  <div class="panel-stat">
                    <dt>Median Sale Price</dt>
                    <dd>
                      {formatCurrency(county.median_sale_price)}
                      {county.median_sale_price_yoy !== null && (
                        <span class={`delta ${county.median_sale_price_yoy >= 0 ? 'up' : 'down'}`}>
                          {county.median_sale_price_yoy >= 0 ? '+' : ''}{county.median_sale_price_yoy.toFixed(1)}% YoY
                        </span>
                      )}
                    </dd>
                  </div>
                  <div class="panel-stat">
                    <dt>Days on Market</dt>
                    <dd>{county.median_dom ?? 'N/A'}</dd>
                  </div>
                  <div class="panel-stat">
                    <dt>Months of Supply</dt>
                    <dd>{county.months_of_supply !== null ? county.months_of_supply.toFixed(1) : 'N/A'}</dd>
                  </div>
                  <div class="panel-stat">
                    <dt>Active Inventory</dt>
                    <dd>{county.inventory !== null ? county.inventory.toLocaleString() : 'N/A'}</dd>
                  </div>
                </dl>

                <a href={`/market/${county.slug}/`} class="panel-link">
                  Browse {county.region} towns
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              </article>
            ))}
          </div>
        </div>

        <div class="scrolly-steps">
          {counties.map((county, i) => (
            <article class:list={['step', { 'is-active': i === 0 }]} data-step={county.slug}>
              <h3>{county.region}</h3>
              <p>{countyNarrative(county)}</p>
              {county.ai_insight && <p class="step-insight">{county.ai_insight}</p>}
              <a href={`/market/${county.slug}/`} class="step-link">
                See every town in {county.region} &rarr;
              </a>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ACT IV — Tools. -->
  <section class="act tools-act" id="tools">
    <div class="container">
      <header class="act-head" data-reveal>
        <p class="eyebrow">Free Tools</p>
        <h2>Run the numbers before we ever speak</h2>
        <p class="act-lede">
          No signup, no email gate, no follow-up you didn't ask for. Use them, and call me
          when you want a second opinion on what they told you.
        </p>
      </header>

      <div class="tools-rail" data-reveal>
        {tools.map((tool) => (
          <a href={tool.href} class="tool-card">
            <h3>{tool.label}</h3>
            <p>{tool.copy}</p>
            <span class="tool-arrow" aria-hidden="true">&rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ACT V — Contact. Keeps id="contact". -->
  <ContactForm />
</BaseLayout>

<style>
  /* ==========================================================================
     ACT 0 — Hero
     One lit CTA against near-black. Everything else is neutral.
     ========================================================================== */
  .hero {
    position: relative;
    min-height: 92vh;
    min-height: 92svh;
    display: flex;
    align-items: center;
    padding: var(--space-16) 0 var(--space-12);
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(80% 60% at 50% 0%, var(--accent-wash) 0%, transparent 70%);
  }

  .hero-inner {
    position: relative;
    text-align: center;
    max-width: 900px;
  }

  .hero-eyebrow {
    margin-bottom: var(--space-6);
  }

  .hero-name {
    font-size: var(--text-4xl);
    letter-spacing: -0.01em;
    margin-bottom: var(--space-6);
  }

  /* The quote is the hero's centrepiece — the one place the slab serif carries
     a display-size line, set against the sans name directly above it. */
  .hero-quote {
    margin: 0 auto var(--space-6);
    padding: var(--space-6) 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    max-width: 760px;
  }

  .hero-quote blockquote p {
    font-family: var(--font-body);
    /* 400, not the body 500: at display size Rokkitt needs no weight
       compensation, and the lighter cut reads as a quotation rather than a
       heading. */
    font-weight: var(--font-normal);
    font-size: var(--text-3xl);
    line-height: 1.25;
    color: var(--text-primary);
    margin: 0;
    text-wrap: balance;
  }

  .hero-sub {
    max-width: 620px;
    margin: 0 auto var(--space-8);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    justify-content: center;
    margin-bottom: var(--space-10);
  }

  .hero-call {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .scroll-cue {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-muted);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    text-decoration: none;
  }

  .scroll-cue:hover {
    color: var(--accent-bright);
    text-decoration: none;
  }

  /* The only lit thing below the fold line. */
  .scroll-cue-line {
    width: 1px;
    height: 56px;
    background: linear-gradient(to bottom, transparent, var(--accent));
  }

  /* ==========================================================================
     Shared act scaffolding
     ========================================================================== */
  .act {
    border-top: 1px solid var(--rule);
  }

  .act-head {
    max-width: 680px;
    margin-bottom: var(--space-10);
  }

  .act-head h2 {
    margin-top: var(--space-3);
  }

  .act-lede {
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  /* Reveal: opacity + a short rise. Neutralised entirely by the reduced-motion
     block at the end of this file and by scrollReveal.ts. */
  [data-reveal] {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 600ms ease, transform 600ms ease;
  }

  [data-reveal].in-view {
    opacity: 1;
    transform: none;
  }

  /* ==========================================================================
     ACT I — Proof
     ========================================================================== */
  .proof {
    background: var(--ink-850);
  }

  .proof-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  .proof-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
  }

  .proof-number {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    line-height: 1;
  }

  .proof-number-sm {
    font-size: var(--text-xl);
  }

  .proof-label {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* ==========================================================================
     ACT II — About
     ========================================================================== */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: start;
  }

  .about-portrait {
    position: relative;
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface-1);
    max-width: 420px;
  }

  /* Dark duotone at rest; the bench lamp catches it on hover. */
  .about-portrait img {
    width: 100%;
    height: auto;
    display: block;
    filter: grayscale(100%) contrast(1.08) brightness(0.42);
    transition: filter var(--transition-slow), transform var(--transition-slow);
  }

  .about-portrait:hover img {
    filter: grayscale(45%) contrast(1.02) brightness(0.7);
    transform: scale(1.02);
  }

  /* Scrim: sinks the portrait's light studio backdrop into the room, and adds
     a cool rim of light from the same direction as the page vignette. */
  .about-portrait::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(200deg, rgba(61, 139, 255, 0.16) 0%, transparent 45%),
      linear-gradient(to top, var(--ink-900) 0%, transparent 55%);
  }

  .about-copy h2 {
    margin-top: var(--space-3);
  }

  .about-copy p {
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  .about-list {
    list-style: none;
    padding: 0;
    margin: var(--space-6) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .about-list li {
    padding-left: var(--space-4);
    border-left: 1px solid var(--rule-strong);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .about-list-title {
    display: block;
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--text-primary);
    margin-bottom: var(--space-1);
  }

  .about-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* ==========================================================================
     ACT III — Market scrolly
     ========================================================================== */
  .market-act {
    background: var(--ink-850);
  }

  .scrolly {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  .figure-frame {
    position: relative;
    background: var(--surface-1);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: var(--space-6);
    /* Panels stack; only the active one is visible on desktop. */
  }

  .panel {
    display: none;
  }

  .panel.is-active {
    display: block;
  }

  .panel-eyebrow {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--space-2);
  }

  .panel-verdict {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    color: var(--text-primary);
    margin-bottom: var(--space-6);
  }

  .panel-stats {
    display: grid;
    gap: 0;
    margin: 0 0 var(--space-6);
  }

  .panel-stat {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--rule);
  }

  /* The term is a label for the figure beside it, not prose. */
  .panel-stat dt {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .panel-stat dd {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    color: var(--text-primary);
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }

  .delta {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
  }

  .delta.up { color: var(--accent-green); }
  .delta.down { color: var(--accent-red); }

  .panel-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--accent-bright);
    text-decoration: none;
  }

  .panel-link:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .scrolly-steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .step {
    padding-left: var(--space-5);
    border-left: 1px solid var(--rule-strong);
    transition: border-color var(--transition-base), opacity var(--transition-base);
  }

  .step.is-active {
    border-left-color: var(--accent);
  }

  .step h3 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }

  .step p {
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  .step-insight {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .step-link {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--accent-bright);
    text-decoration: none;
  }

  .step-link:hover {
    color: var(--accent);
  }

  /* ==========================================================================
     ACT IV — Tools
     ========================================================================== */
  .tools-rail {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  .tool-card {
    position: relative;
    display: block;
    padding: var(--space-6);
    background: var(--surface-1);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all var(--transition-base);
  }

  .tool-card:hover {
    background: var(--surface-2);
    border-color: var(--accent-line);
    box-shadow: var(--glow-soft);
    text-decoration: none;
    transform: translateY(-3px);
  }

  .tool-card h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
    color: var(--text-primary);
  }

  .tool-card p {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin: 0;
