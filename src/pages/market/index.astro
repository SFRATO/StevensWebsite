---
/**
 * Market Hub Page
 * Overview of all NJ market areas served
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import { generateBreadcrumbSchema, generateFAQSchema } from '@utils/schema';

// Import market data
import countiesData from '../../../data/processed/counties.json';

interface CountyData {
  region: string;
  slug: string;
  state_code: string;
  period_end: string;
  median_sale_price: number | null;
  median_sale_price_yoy: number | null;
  inventory: number | null;
  inventory_yoy: number | null;
  months_of_supply: number | null;
  median_dom: number | null;
  market_type: 'seller' | 'buyer' | 'balanced';
  ai_insight?: string;
}

const counties = countiesData as CountyData[];

// Format currency
const formatCurrency = (value: number | null): string => {
  if (value === null) return 'N/A';
  return new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD',
    maximumFractionDigits: 0,
  }).format(value);
};

// Get current month/year for title
const currentDate = new Date();
const currentMonthYear = currentDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

// Generate breadcrumb schema
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Home', url: 'https://stevenfrato.com/' },
  { name: 'Market Data', url: 'https://stevenfrato.com/market/' },
]);

const marketFaqs = [
  { question: 'What is the current NJ housing market like in 2026?', answer: 'The NJ housing market in 2026 remains competitive across Burlington, Mercer, and Middlesex Counties. Inventory is limited in most areas, keeping upward pressure on prices. Burlington and Mercer counties are seller\'s markets with median days on market under 30 days in many towns. Use the county pages below for the most current data in your specific area.' },
  { question: 'Are NJ home prices going up or down?', answer: 'Home prices in NJ have generally appreciated year-over-year across Burlington, Mercer, and Middlesex Counties, though the rate varies significantly by town and zip code. Some areas are seeing price growth of 5–10% YoY, while others are more stable. Check the individual county and town pages for the latest price trend data updated monthly.' },
  { question: 'Is it a buyer\'s or seller\'s market in Burlington County NJ?', answer: 'Burlington County is generally a seller\'s market, with months of supply below 4 in most towns. This means there are more buyers than available homes, leading to faster sales and stronger offers. However, market conditions vary by price range and specific town — use the Burlington County market page to see the latest data.' },
  { question: 'What is the median home price in NJ?', answer: 'Median home prices vary widely across NJ. In Burlington County, the median sale price is typically in the $350,000–$450,000 range. Mercer County centers around $400,000–$500,000, while Middlesex County ranges from $400,000 to $550,000+. Check the individual county pages below for the most current figures updated each month.' },
  { question: 'How do I get a free NJ market report for my area?', answer: 'Fill out the contact form on this site or call Steven Frato at (609) 789-0126. You\'ll receive a personalized market report for your specific town or zip code within hours, covering median prices, days on market, and a recommendation on whether now is a good time to buy or sell.' },
];

const faqSchema = generateFAQSchema(marketFaqs);

// Page meta
const title = `NJ Real Estate Market Data 2026 — Burlington, Mercer & Middlesex County`;
const description = `Current NJ housing market data updated monthly. View median home prices, inventory levels, days on market, and trends for Burlington, Mercer, and Middlesex Counties.`;
---

<BaseLayout title={title} description={description} schema={[breadcrumbSchema, faqSchema]}>
  <!-- Hero Section: Primary CTA -->
  <section class="market-hero">
    <div class="container">
      <h1>Navigate the NJ Real Estate Market with Confidence</h1>
      <p class="hero-subtitle">
        Whether you're buying or selling, get expert guidance from a local agent who knows Burlington, Mercer, and Middlesex Counties.
      </p>

      <div class="hero-cta">
        <a href="tel:+16097890126" class="btn btn-primary btn-lg">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          Call (609) 789-0126
        </a>
      </div>

      <p class="trust-line">Century 21 | Serving Burlington, Mercer & Middlesex Counties</p>
    </div>
  </section>

  <!-- County Market Data -->
  <section class="counties-section">
    <div class="container">
      <h2 class="counties-heading">Market Data by County</h2>

      <div class="counties-grid">
        {counties.map((county) => (
          <a href={`/market/${county.slug}/`} class="county-card">
            <div class="county-header">
              <h3>{county.region}</h3>
              <span class={`market-badge badge-${county.market_type}`}>
                {county.market_type === 'seller' ? "Seller's Market" :
                 county.market_type === 'buyer' ? "Buyer's Market" : 'Balanced'}
              </span>
            </div>

            <div class="county-stats">
              <div class="stat">
                <span class="stat-label">Median Price</span>
                <span class="stat-value">{formatCurrency(county.median_sale_price)}</span>
                {county.median_sale_price_yoy !== null && (
                  <span class={`stat-change ${county.median_sale_price_yoy >= 0 ? 'positive' : 'negative'}`}>
                    {county.median_sale_price_yoy >= 0 ? '+' : ''}{county.median_sale_price_yoy.toFixed(1)}% YoY
                  </span>
                )}
              </div>

              <div class="stat">
                <span class="stat-label">Days on Market</span>
                <span class="stat-value">{county.median_dom ?? 'N/A'}</span>
              </div>
            </div>

            <div class="county-footer">
              <span class="view-details">
                View Towns
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                  <path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>

      <div class="market-tools-row">
        <a href="/tools/home-value-estimator/" class="tool-pill">🏠 Home Value Estimator</a>
        <a href="/tools/should-i-sell-now/" class="tool-pill">📊 Market Timing Tool</a>
        <a href="/tools/proceeds-calculator/" class="tool-pill">💰 Proceeds Calculator</a>
        <a href="/home-value/" class="tool-pill">🔍 Browse Home Values by Town</a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="market-faq">
    <div class="container">
      <h2>NJ Housing Market — Common Questions</h2>
      <div class="faq-list">
        {marketFaqs.map((faq) => (
          <details class="faq-item">
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero Section */
  .market-faq {
    padding: var(--space-12) 0;
    background: var(--surface-2);
  }
  .market-faq h2 {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    color: var(--text-primary);
    margin-bottom: var(--space-6);
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 800px;
  }
  .faq-item {
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    background: var(--surface-1);
    overflow: hidden;
  }
  .faq-item summary {
    padding: var(--space-4) var(--space-5);
    font-weight: var(--font-semibold);
    cursor: pointer;
    color: var(--text-primary);
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item p {
    padding: 0 var(--space-5) var(--space-4);
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  .market-hero {
    background: linear-gradient(135deg, var(--ink-850) 0%, var(--ink-850) 70%, var(--accent-wash-strong) 100%);
    padding: var(--space-16) 0;
    text-align: center;
  }

  .market-hero h1 {
    font-family: var(--font-heading);
    font-size: var(--text-4xl);
    color: var(--white);
    margin-bottom: var(--space-4);
    line-height: 1.2;
  }

  .hero-subtitle {
    font-size: var(--text-lg);
    color: rgba(255, 255, 255, 0.85);
    max-width: 600px;
    margin: 0 auto var(--space-8);
    line-height: 1.6;
  }

  .hero-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-8);
    border-radius: var(--radius-md);
    font-weight: var(--font-semibold);
    font-size: var(--text-base);
    text-decoration: none;
    transition: all var(--transition-base);
    cursor: pointer;
  }

  .btn-primary {
    background-color: var(--accent);
    color: var(--accent-ink);
  }

  .btn-primary:hover {
    background-color: var(--accent-bright);
    transform: translateY(-2px);
  }

  .btn-lg {
    padding: var(--space-5) var(--space-10);
    font-size: var(--text-lg);
  }

  .trust-line {
    color: rgba(255, 255, 255, 0.6);
    font-size: var(--text-sm);
    margin: 0;
  }

  @media (min-width: 640px) {
    .hero-cta {
      flex-direction: row;
      justify-content: center;
    }
  }

  @media (max-width: 768px) {
    .market-hero {
      padding: var(--space-12) 0;
    }

    .market-hero h1 {
      font-size: var(--text-2xl);
    }

    .hero-subtitle {
      font-size: var(--text-base);
    }

    .btn-lg {
      width: 100%;
      max-width: 300px;
    }

  }

  /* Counties Section */
  .counties-section {
    padding: var(--space-12) 0;
    background-color: var(--off-white);
  }

  .counties-heading {
    font-size: var(--text-2xl);
    color: var(--text-primary);
    margin-bottom: var(--space-6);
  }

  .counties-grid {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .counties-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .counties-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .county-card {
    background: var(--surface-1);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-md);
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    transition: all var(--transition-base);
  }

  .county-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  .county-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .county-header h3 {
    font-size: var(--text-xl);
    color: var(--text-primary);
    margin: 0;
  }

  .market-badge {
    font-size: var(--text-xs);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .badge-seller {
    background-color: rgba(76, 175, 80, 0.1);
    color: var(--accent-green);
  }

  .badge-buyer {
    background-color: rgba(229, 57, 53, 0.1);
    color: var(--accent-red);
  }

  .badge-balanced {
    background-color: rgba(61, 139, 255, 0.12);
    color: var(--text-primary);
  }

  .county-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .stat-label {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .stat-value {
    font-family: var(--font-heading);
    font-variant-numeric: tabular-nums;
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: var(--text-primary);
  }

  .stat-change {
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
  }

  .stat-change.positive {
    color: var(--accent-green);
  }

  .stat-change.negative {
    color: var(--accent-red);
  }

  .county-footer {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-color);
    margin-top: auto;
  }

  .view-details {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--text-primary);
    font-weight: var(--font-semibold);
    font-size: var(--text-sm);
  }

  @media (max-width: 768px) {
    .counties-section {
      padding: var(--space-8) 0;
    }
  }

  .market-tools-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--rule);
  }

  .tool-pill {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: var(--surface-1);
    border: 2px solid var(--rule-strong);
    border-radius: 999px;
    color: var(--text-primary);
    font-weight: 600;
    font-size: var(--text-sm);
    text-decoration: none;
    transition: all 0.2s;
  }

  .tool-pill:hover {
    background: var(--accent-bright);
    color: var(--text-primary);
  }
</style>
